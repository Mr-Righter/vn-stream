# Local application data and externally obtained game/runtime content.
/var/
/games/
/saves/
/runtimes/
/downloads/

# Real credentials and machine-specific configuration.
.env
.env.*
!.env.example
!.env.*.example
/config/local/
/config/secrets/
*.key

# Game packages, compiled scripts, and saves.
*.zip
*.apk
*.aab
*.apks
*.obb
*.7z
*.rar
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz
*.rpa
*.rpyc
*.save
# Only deliberately curated test fixtures belong in source control.
!tests/fixtures/**/
!tests/fixtures/**/*.zip
!tests/fixtures/**/*.apk
!tests/fixtures/**/*.rpa
!tests/fixtures/**/*.rpyc

# Python development output.
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Browser dependencies and build output.
node_modules/
dist/
build/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# Local logs, databases, editors, and operating-system files.
*.log
*.sqlite
*.sqlite3
*.sqlite3-*
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo

# Local build tooling.
/.tools/

# Container health probe session credentials.
health.cookies

# Development dependency links in isolated worktrees.
/web/node_modules
/.venv
/.tools

# Licensed, documented tiny archive decoder fixtures.
!tests/unit/archive_fixtures/rar5-crc.rar
!tests/unit/archive_fixtures/rar5-hpsw.rar
!tests/unit/archive_fixtures/rar5-psw.rar
!tests/unit/archive_fixtures/zipcrypto.zip
