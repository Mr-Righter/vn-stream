* text=auto
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
Dockerfile* text eol=lf
*.png binary
*.jpg binary
*.webp binary
*.zip binary
*.apk binary
*.rpa binary
*.rpyc binary

# Unified patches preserve context markers and upstream mixed indentation.
containers/native-patches/**/*.patch whitespace=-blank-at-eol,-space-before-tab

# Preserve the verbatim third-party notice, including its upstream trailing spaces.
containers/native-build/zero/licenses/stb-copyright whitespace=-blank-at-eol
