+/// Null is a present value; it must not be mistaken for an omitted save field.
+#[test]
+fn null_and_void_members_have_distinct_shapes() {
+    let _lock = vm_lock();
+    let engine = Tjs2Engine::new().unwrap();
+    let object = retained_object(&engine, "%[ nullValue:null, voidValue:void ]");
+    let null = engine.member_read(object.raw_id(), "nullValue").unwrap();
+    assert_eq!(format!("{null:?}"), "Null");
+    let void = engine.member_read(object.raw_id(), "voidValue").unwrap();
+    assert!(matches!(void, MemberRead::Void), "void member: {void:?}");
+    let missing = engine.member_read(object.raw_id(), "absentValue").unwrap();
+    assert!(
+        matches!(missing, MemberRead::Void),
+        "absent member: {missing:?}"
+    );
+}
