diff --git a/crates/compat/tests/kag_restore_macros.rs b/crates/compat/tests/kag_restore_macros.rs
new file mode 100644
--- /dev/null
+++ b/crates/compat/tests/kag_restore_macros.rs
@@ -0,0 +1,159 @@
+//! Saved macro policy follows the public dictionary, not private walk metadata.
+//! reference/cpp/core/kag/KAGParser.cpp:727-735
+
+mod common;
+
+use common::{Env, vm_lock};
+
+fn startup_parser() -> Env {
+    let env = Env::with_storage();
+    std::fs::write(
+        env.game_dir()
+            .expect("mounted game directory")
+            .join("resume.ks"),
+        b"*start\n[np]\n",
+    )
+    .expect("write self-authored scenario");
+    env.run(
+        r#"
+        var parser=new KAGParser();
+        parser.macros.np='[ch text="startup"]';
+        parser.loadScenario('resume.ks');
+        parser.getNextTag();
+        var saved=parser.store();
+        function readText() {
+            var text='';
+            while(true) {
+                var tag=parser.getNextTag();
+                if(!tag) break;
+                if(tag.tagname==='ch') text+=tag.text;
+            }
+            return text;
+        }
+        "#,
+    );
+    env
+}
+
+#[test]
+fn reference_save_with_void_macros_preserves_startup_macros() {
+    let _lock = vm_lock();
+    let env = startup_parser();
+    env.run("delete saved.data; saved.macros=void; parser.restore(saved); var text=readText();");
+    assert_eq!(env.eval_int("text==='startup'"), 1);
+}
+
+#[test]
+fn reference_save_without_macros_preserves_startup_macros() {
+    let _lock = vm_lock();
+    let env = startup_parser();
+    env.run("delete saved.data; delete saved.macros; parser.restore(saved); var text=readText();");
+    assert_eq!(env.eval_int("text==='startup'"), 1);
+}
+
+#[test]
+fn explicit_empty_macro_dictionary_erases_startup_macros() {
+    let _lock = vm_lock();
+    let env = startup_parser();
+    env.run("delete saved.data; saved.macros=%[]; parser.restore(saved); var tag=parser.getNextTag(); while(tag && tag.tagname!=='np') tag=parser.getNextTag();");
+    assert_eq!(env.eval_int("parser.macros.np===void"), 1);
+    assert_eq!(env.eval_int("tag && tag.tagname==='np'"), 1);
+}
+
+#[test]
+fn private_empty_snapshot_does_not_override_void_macro_policy() {
+    let _lock = vm_lock();
+    let env = startup_parser();
+    env.run(
+        "var empty=new KAGParser(); empty.loadScenario('resume.ks'); saved.data=empty.store().data; saved.macros=void; parser.restore(saved); var text=readText();",
+    );
+    assert_eq!(env.eval_int("text==='startup'"), 1);
+}
+
+#[test]
+fn public_macro_dictionary_overrides_the_private_snapshot() {
+    let _lock = vm_lock();
+    let env = startup_parser();
+    env.run(
+        r#"saved.macros=%[np:'[ch text="replacement"]']; parser.restore(saved); var text=readText();"#,
+    );
+    assert_eq!(env.eval_int("text==='replacement'"), 1);
+}
+
+#[test]
+fn public_empty_macro_dictionary_overrides_the_private_snapshot() {
+    let _lock = vm_lock();
+    let env = startup_parser();
+    env.run("saved.macros=%[]; parser.restore(saved);");
+    assert_eq!(env.eval_int("parser.macros.np===void"), 1);
+}
+
+fn invalid_macro_error(private_snapshot: bool, literal: &str) {
+    let env = startup_parser();
+    if !private_snapshot {
+        env.run("delete saved.data;");
+    }
+    env.run(&format!("saved.macros={literal};"));
+    let error = env.error("parser.restore(saved)");
+    assert!(!error.is_empty(), "a non-object macro table must raise");
+}
+
+#[test]
+fn reference_save_rejects_a_scalar_macro_table() {
+    let _lock = vm_lock();
+    invalid_macro_error(false, "42");
+}
+
+#[test]
+fn private_snapshot_rejects_a_scalar_macro_table() {
+    let _lock = vm_lock();
+    invalid_macro_error(true, "42");
+}
+
+fn macro_getter_error(private_snapshot: bool) {
+    let env = startup_parser();
+    env.run(
+        r#"
+        class BrokenSave {
+            var data;
+            function BrokenSave(snapshot) { data=snapshot; }
+            property macros {
+                getter() { throw %[message:'macro lookup failed']; }
+            }
+        }
+        var broken=new BrokenSave(saved.data);
+        "#,
+    );
+    if !private_snapshot {
+        env.run("broken.data=void;");
+    }
+    let error = env.error("parser.restore(broken)");
+    assert!(
+        error.contains("macro lookup failed"),
+        "getter error: {error:?}"
+    );
+}
+
+#[test]
+fn reference_save_propagates_a_macro_getter_exception() {
+    let _lock = vm_lock();
+    macro_getter_error(false);
+}
+
+#[test]
+fn private_snapshot_propagates_a_macro_getter_exception() {
+    let _lock = vm_lock();
+    macro_getter_error(true);
+}
+
+#[test]
+fn reference_save_rejects_a_null_macro_table() {
+    let _lock = vm_lock();
+    invalid_macro_error(false, "null");
+}
+
+#[test]
+fn private_snapshot_rejects_a_null_macro_table() {
+    let _lock = vm_lock();
+    invalid_macro_error(true, "null");
+}
