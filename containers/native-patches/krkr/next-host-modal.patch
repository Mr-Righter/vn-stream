+bool PumpModalHost(void* context) {
+  auto* impl = static_cast<engine_handle_s*>(context);
+  auto& callbacks = impl->host_callbacks;
+  if (!callbacks.pump_events || !callbacks.present_frame ||
+      impl->owner_thread != std::this_thread::get_id()) return false;
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(16);
+  if (!callbacks.pump_events(callbacks.user_data)) return false;
+  while (!impl->input.pending_events.empty()) {
+    const auto event = impl->input.pending_events.front();
+    impl->input.pending_events.pop_front();
+    const char* error = nullptr;
+    if (DispatchInputEventNow(impl, event, &error) != ENGINE_RESULT_OK)
+      throw std::runtime_error(error ? error : "modal input dispatch failed");
+  }
+  if (Application) Application->Run();
+  if (TVPTerminated) return false;
+  TVPDeliverWindowUpdateEvents();
+  TVPComposeHostWindows();
+  TVPDrawSceneOnce(0);
+  CaptureFrameLocked(impl);
+  if (impl->frame.ready)
+    callbacks.present_frame(callbacks.user_data, impl->frame.rgba.data(),
+                            impl->frame.width, impl->frame.height, impl->frame.stride_bytes);
+  std::this_thread::sleep_until(deadline);
+  return true;
 }
 
