+const AC_CHROMA_BITS: [u8; 17] = [
+    0x00, 0x00, 0x02, 0x01, 0x02, 0x04, 0x04, 0x03, 0x04, 0x07, 0x05, 0x04, 0x04, 0x00, 0x01, 0x02,
+    0x77,
+];
+
+const AC_CHROMA_VALUES: [u8; 162] = [
+    0x00, 0x01, 0x02, 0x03, 0x11, 0x04, 0x05, 0x21, 0x31, 0x06, 0x12, 0x41, 0x51, 0x07, 0x61, 0x71,
+    0x13, 0x22, 0x32, 0x81, 0x08, 0x14, 0x42, 0x91, 0xa1, 0xb1, 0xc1, 0x09, 0x23, 0x33, 0x52, 0xf0,
+    0x15, 0x62, 0x72, 0xd1, 0x0a, 0x16, 0x24, 0x34, 0xe1, 0x25, 0xf1, 0x17, 0x18, 0x19, 0x1a, 0x26,
+    0x27, 0x28, 0x29, 0x2a, 0x35, 0x36, 0x37, 0x38, 0x39, 0x3a, 0x43, 0x44, 0x45, 0x46, 0x47, 0x48,
+    0x49, 0x4a, 0x53, 0x54, 0x55, 0x56, 0x57, 0x58, 0x59, 0x5a, 0x63, 0x64, 0x65, 0x66, 0x67, 0x68,
+    0x69, 0x6a, 0x73, 0x74, 0x75, 0x76, 0x77, 0x78, 0x79, 0x7a, 0x82, 0x83, 0x84, 0x85, 0x86, 0x87,
+    0x88, 0x89, 0x8a, 0x92, 0x93, 0x94, 0x95, 0x96, 0x97, 0x98, 0x99, 0x9a, 0xa2, 0xa3, 0xa4, 0xa5,
+    0xa6, 0xa7, 0xa8, 0xa9, 0xaa, 0xb2, 0xb3, 0xb4, 0xb5, 0xb6, 0xb7, 0xb8, 0xb9, 0xba, 0xc2, 0xc3,
+    0xc4, 0xc5, 0xc6, 0xc7, 0xc8, 0xc9, 0xca, 0xd2, 0xd3, 0xd4, 0xd5, 0xd6, 0xd7, 0xd8, 0xd9, 0xda,
+    0xe2, 0xe3, 0xe4, 0xe5, 0xe6, 0xe7, 0xe8, 0xe9, 0xea, 0xf2, 0xf3, 0xf4, 0xf5, 0xf6, 0xf7, 0xf8,
+    0xf9, 0xfa,
+];
+
+const DC_VALUES: [u8; 12] = [
+    0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b,
+];
+
+const NATURAL_ORDER: [u8; 64] = [
+    0, 1, 8, 16, 9, 2, 3, 10, 17, 24, 32, 25, 18, 11, 4, 5, 12, 19, 26, 33, 40, 48, 41, 34, 27, 20,
+    13, 6, 7, 14, 21, 28, 35, 42, 49, 56, 57, 50, 43, 36, 29, 22, 15, 23, 30, 37, 44, 51, 58, 59,
+    52, 45, 38, 31, 39, 46, 53, 60, 61, 54, 47, 55, 62, 63,
+];
+
+struct Bits<'a> {
+    bytes: &'a [u8],
+    byte: usize,
+    bit: u8,
+}
+
+impl Bits<'_> {
+    fn read(&mut self, count: u8) -> Result<i32, AlphaMovieError> {
+        let mut value = 0;
+        for _ in 0..count {
+            let byte = self
+                .bytes
+                .get(self.byte)
+                .ok_or(AlphaMovieError::Entropy("truncated coefficient bits"))?;
+            value = (value << 1) | i32::from((byte >> (7 - self.bit)) & 1);
+            self.bit += 1;
+            if self.bit == 8 {
+                self.bit = 0;
+                self.byte += 1;
+            }
+        }
+        Ok(value)
+    }
+
+    fn signed(&mut self, count: u8) -> Result<i32, AlphaMovieError> {
+        if count == 0 {
+            return Ok(0);
+        }
+        let value = self.read(count)?;
+        Ok(if value < 1 << (count - 1) {
+            value + 1 - (1 << count)
+        } else {
+            value
+        })
+    }
+
+    fn symbol(&mut self, lengths: &[u8; 17], symbols: &[u8]) -> Result<u8, AlphaMovieError> {
+        let mut code = 0;
+        let mut first = 0;
+        let mut offset = 0;
+        for &count in &lengths[1..] {
+            code = (code << 1) | self.read(1)?;
+            let difference = code - first;
+            if difference >= 0 && difference < i32::from(count) {
+                let index = usize::try_from(difference)
+                    .map_err(|_| AlphaMovieError::Entropy("negative Huffman index"))?;
+                return symbols
+                    .get(offset + index)
+                    .copied()
+                    .ok_or(AlphaMovieError::Entropy("invalid Huffman symbol"));
+            }
+            offset += usize::from(count);
+            first = (first + i32::from(count)) << 1;
+        }
+        Err(AlphaMovieError::Entropy("invalid Huffman code"))
+    }
+}
+
+pub(super) struct Decoder<'a> {
+    bits: Bits<'a>,
+    luma_dc: i32,
+    chroma_dc: i32,
+}
+
+impl<'a> Decoder<'a> {
+    pub(super) const fn new(bytes: &'a [u8]) -> Self {
+        Self {
+            bits: Bits {
+                bytes,
+                byte: 0,
+                bit: 0,
+            },
+            luma_dc: 0,
+            chroma_dc: 0,
+        }
+    }
+
+    pub(super) fn luma(
+        &mut self,
+        quantization: &[u8; 64],
+        pixels: &mut [u8],
+        pitch: usize,
+    ) -> Result<(), AlphaMovieError> {
+        self.block(quantization, pixels, pitch, false)
+    }
+
+    pub(super) fn chroma(
+        &mut self,
+        quantization: &[u8; 64],
+        pixels: &mut [u8],
+        pitch: usize,
+    ) -> Result<(), AlphaMovieError> {
+        self.block(quantization, pixels, pitch, true)
+    }
+
+    fn block(
+        &mut self,
+        quantization: &[u8; 64],
+        pixels: &mut [u8],
+        pitch: usize,
+        chroma: bool,
+    ) -> Result<(), AlphaMovieError> {
+        let (dc_bits, ac_bits, ac_values, previous) = if chroma {
+            (
+                &DC_CHROMA_BITS,
+                &AC_CHROMA_BITS,
+                &AC_CHROMA_VALUES,
+                &mut self.chroma_dc,
+            )
+        } else {
+            (
+                &DC_LUMA_BITS,
+                &AC_LUMA_BITS,
+                &AC_LUMA_VALUES,
+                &mut self.luma_dc,
+            )
+        };
+        let size = self.bits.symbol(dc_bits, &DC_VALUES)?;
+        let dc = previous
+            .checked_add(self.bits.signed(size)?)
+            .ok_or(AlphaMovieError::Entropy("DC predictor overflow"))?;
+        let dc = i16::try_from(dc)
+            .map_err(|_| AlphaMovieError::Entropy("DC coefficient exceeds signed 16-bit range"))?;
+        *previous = i32::from(dc);
+        let mut coefficients = [0_i32; 64];
+        coefficients[0] = i32::from(dc);
+        let mut index = 1;
+        while index < 64 {
+            let symbol = self.bits.symbol(ac_bits, ac_values)?;
+            let run = usize::from(symbol >> 4);
+            let size = symbol & 15;
+            if size == 0 {
+                if run == 0 {
+                    break;
+                }
+                if run != 15 || index + 16 > 64 {
+                    return Err(AlphaMovieError::Entropy("AC zero run exceeds block"));
+                }
+                index += 16;
+            } else {
+                index += run;
+                if index >= 64 {
+                    return Err(AlphaMovieError::Entropy("AC coefficient exceeds block"));
+                }
+                coefficients[usize::from(NATURAL_ORDER[index])] = self.bits.signed(size)?;
+                index += 1;
+            }
+        }
+        if index == 1 {
+            let sample = (i32::from(dc) * i32::from(quantization[0]) / 8 + 128).clamp(0, 255);
+            let sample = u8::try_from(sample)
+                .map_err(|_| AlphaMovieError::Entropy("DC sample out of range"))?;
+            for row in 0..8 {
+                pixels[row * pitch..][..8].fill(sample);
+            }
+        } else {
+            idct::transform(&coefficients, quantization, pixels, pitch);
+        }
+        Ok(())
+    }
+}
