+#[test]
+fn malformed_huffman_runs_and_predictor_overflows_are_typed() {
+    let mut bad_run = "0000000000".to_owned();
+    for _ in 0..4 {
+        bad_run.push_str("11111111001");
+    }
+    while !bad_run.len().is_multiple_of(8) {
+        bad_run.push('0');
+    }
+    let bad_run: Vec<_> = bad_run
+        .as_bytes()
+        .chunks(8)
+        .map(|chunk| chunk.iter().fold(0, |byte, bit| (byte << 1) | (bit - b'0')))
+        .collect();
+    for entropy in [vec![255; 64], bad_run] {
+        let decoder =
+            AlphaMovie::open(Arc::from(movie(1, &[(16, 16, entropy)])), limits()).unwrap();
+        // reference/cpp/plugins/AlphaMovie.cpp:252-263,298-332: Huffman
+        // lengths and AC runs must remain inside their code and block domains.
+        assert!(matches!(
+            decoder.decode(0),
+            Err(AlphaMovieError::Entropy(_))
+        ));
+    }
+    let mut overflow = String::new();
+    for _ in 0..4 {
+        overflow.push_str("00000000");
+        for _ in 0..8 {
+            dc_block(&mut overflow, 2047, false);
+        }
+    }
+    while !overflow.len().is_multiple_of(8) {
+        overflow.push('0');
+    }
+    let overflow: Vec<_> = overflow
+        .as_bytes()
+        .chunks(8)
+        .map(|chunk| chunk.iter().fold(0, |byte, bit| (byte << 1) | (bit - b'0')))
+        .collect();
+    let decoder = AlphaMovie::open(Arc::from(movie(1, &[(32, 32, overflow)])), limits()).unwrap();
+    // reference/cpp/plugins/AlphaMovie.cpp:291-292,851-855: coefficients
+    // occupy signed16 storage; malformed predictors must not wrap or panic.
+    assert!(matches!(
+        decoder.decode(0),
+        Err(AlphaMovieError::Entropy(_))
+    ));
+}
