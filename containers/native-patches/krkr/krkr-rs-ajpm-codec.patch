+//! Integer ISLOW inverse DCT.
+//!
+//! Algorithm attribution: Independent JPEG Group, Copyright (C) 1991-1998
+//! Thomas G. Lane. The fixed-point constants implement the Loeffler transform.
+
+fn butterfly(input: [i64; 8]) -> [i64; 8] {
+    let z2 = input[2];
+    let z3 = input[6];
+    let z1 = (z2 + z3) * 4433;
+    let tmp2 = z1 - z3 * 15137;
+    let tmp3 = z1 + z2 * 6270;
+    let tmp0 = (input[0] + input[4]) << 13;
+    let tmp1 = (input[0] - input[4]) << 13;
+    let tmp10 = tmp0 + tmp3;
+    let tmp13 = tmp0 - tmp3;
+    let tmp11 = tmp1 + tmp2;
+    let tmp12 = tmp1 - tmp2;
+    let mut tmp0 = input[7];
+    let mut tmp1 = input[5];
+    let mut tmp2 = input[3];
+    let mut tmp3 = input[1];
+    let z1 = (tmp0 + tmp3) * -7373;
+    let z2 = (tmp1 + tmp2) * -20995;
+    let z3 = tmp0 + tmp2;
+    let z4 = tmp1 + tmp3;
+    let z5 = (z3 + z4) * 9633;
+    let z3 = z3 * -16069 + z5;
+    let z4 = z4 * -3196 + z5;
+    tmp0 = tmp0 * 2446 + z1 + z3;
+    tmp1 = tmp1 * 16819 + z2 + z4;
+    tmp2 = tmp2 * 25172 + z2 + z3;
+    tmp3 = tmp3 * 12299 + z1 + z4;
+    [
+        tmp10 + tmp3,
+        tmp11 + tmp2,
+        tmp12 + tmp1,
+        tmp13 + tmp0,
+        tmp13 - tmp0,
+        tmp12 - tmp1,
+        tmp11 - tmp2,
+        tmp10 - tmp3,
+    ]
+}
+
+pub(super) fn transform(
+    coefficients: &[i32; 64],
+    quantization: &[u8; 64],
+    pixels: &mut [u8],
+    pitch: usize,
+) {
+    let mut workspace = [0_i64; 64];
+    for col in 0..8 {
+        if (1..8).all(|row| coefficients[row * 8 + col] == 0) {
+            let dc = i64::from(coefficients[col]) * i64::from(quantization[col]) * 4;
+            for row in 0..8 {
+                workspace[row * 8 + col] = dc;
+            }
+        } else {
+            let mut input = [0; 8];
+            for (row, sample) in input.iter_mut().enumerate() {
+                *sample =
+                    i64::from(coefficients[row * 8 + col]) * i64::from(quantization[row * 8 + col]);
+            }
+            for (row, sample) in butterfly(input).into_iter().enumerate() {
+                workspace[row * 8 + col] = (sample + 1024) >> 11;
+            }
+        }
+    }
+    for row in 0..8 {
+        let input = std::array::from_fn(|col| workspace[row * 8 + col]);
+        if input[1..].iter().all(|&sample| sample == 0) {
+            pixels[row * pitch..][..8].fill(range_sample((input[0] + 16) >> 5));
+        } else {
+            for (col, sample) in butterfly(input).into_iter().enumerate() {
+                pixels[row * pitch + col] = range_sample((sample + 131072) >> 18);
+            }
+        }
+    }
+}
+
+fn range_sample(value: i64) -> u8 {
+    // The 10-bit range table saturates transform overshoot and wraps its tail.
+    let index = value & 1023;
+    if index <= 127 {
+        (index + 128).to_le_bytes()[0]
+    } else if index <= 511 {
+        255
+    } else if index <= 895 {
+        0
+    } else {
+        (index - 896).to_le_bytes()[0]
+    }
+}
