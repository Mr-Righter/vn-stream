@@ -0,0 +1,49 @@
+//! Decode a local AJPM corpus without running project code.
+use std::path::Path;
+use std::sync::Arc;
+use std::time::Instant;
+
+use media::alpha_movie::{AlphaMovie, AlphaMovieLimits};
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let directory = std::env::args()
+        .nth(1)
+        .ok_or("usage: alpha_movie DIRECTORY")?;
+    let mut paths = std::fs::read_dir(Path::new(&directory))?
+        .map(|entry| entry.map(|entry| entry.path()))
+        .collect::<Result<Vec<_>, _>>()?;
+    paths.sort();
+    let mut count = 0_u64;
+    for path in paths {
+        if path.extension().and_then(|value| value.to_str()) != Some("amv") {
+            continue;
+        }
+        let movie = AlphaMovie::open(
+            Arc::from(std::fs::read(&path)?),
+            AlphaMovieLimits {
+                max_frames: 100_000,
+                max_frame_pixels: 16 * 1024 * 1024,
+            },
+        )?;
+        let started = Instant::now();
+        let metadata = movie.metadata();
+        let mut hash = 0xcbf29ce484222325_u64;
+        for index in 0..metadata.num_frames {
+            let frame = movie.decode(index)?;
+            for pixel in frame.rgba {
+                hash = (hash ^ u64::from(pixel)).wrapping_mul(0x100000001b3);
+            }
+            count += 1;
+        }
+        println!(
+            "{}\t{}\t{}x{}\t{:.3}ms\t{hash:016x}",
+            path.display(),
+            metadata.num_frames,
+            metadata.width,
+            metadata.height,
+            started.elapsed().as_secs_f64() * 1000.0
+        );
+    }
+    println!("decoded_frames={count}");
+    Ok(())
+}
diff --git a/crates/platform/media/src/alpha_movie.rs b/crates/platform/media/src/alpha_movie.rs
new file mode 100644
index 0000000..4cf3c86
--- /dev/null
+++ b/crates/platform/media/src/alpha_movie.rs
@@ -0,0 +1,396 @@
+//! Bounded, indexed AJPM decoding with separate or block-coded alpha.
+//!
+//! Input bytes and decoded frames belong to the caller. Opening validates the
+//! container and builds a compact index; decoding expands only one frame.
+
+mod entropy;
+mod idct;
+
+use std::{fmt, ops::Range, sync::Arc};
+
+use flate2::{Decompress, FlushDecompress, Status};
+
+/// Caller-selected bounds for the index and individual decoded rectangles.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct AlphaMovieLimits {
+    /// Largest permitted number of indexed frames.
+    pub max_frames: usize,
+    /// Largest permitted width times height of any frame, in pixels.
+    pub max_frame_pixels: usize,
+}
+
+/// Exact container metadata; frame rectangles can exceed the nominal screen.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct AlphaMovieMetadata {
+    /// Number of frames in the container.
+    pub num_frames: u32,
+    /// Denominator of the exact frames-per-second rational.
+    pub fps_scale: u32,
+    /// Numerator of the exact frames-per-second rational.
+    pub fps_rate: u32,
+    /// Nominal screen width in pixels.
+    pub width: u16,
+    /// Nominal screen height in pixels.
+    pub height: u16,
+}
+
+/// One frame rectangle with tightly packed, straight-alpha RGBA8 pixels.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct AlphaMovieFrame {
+    /// Zero-based frame number.
+    pub index: u32,
+    /// Rectangle origin in nominal screen coordinates, in pixels.
+    pub left: u16,
+    /// Rectangle origin in nominal screen coordinates, in pixels.
+    pub top: u16,
+    /// Decoded rectangle width in pixels, including any padding.
+    pub width: u16,
+    /// Decoded rectangle height in pixels, including any padding.
+    pub height: u16,
+    /// Row-major RGBA8 bytes, with no premultiplication or screen cropping.
+    pub rgba: Vec<u8>,
+}
+
+/// Container, resource, entropy, and alpha-plane failures.
+#[derive(Clone, Debug, PartialEq, Eq)]
+#[non_exhaustive]
+pub enum AlphaMovieError {
+    /// Invalid or truncated container structure.
+    Format(&'static str),
+    /// A caller-supplied resource bound would be exceeded.
+    ResourceLimit(&'static str),
+    /// A buffer allocation cannot be satisfied.
+    Allocation(String),
+    /// Missing or invalid Huffman coefficients.
+    Entropy(&'static str),
+    /// The compressed alpha plane is invalid or has the wrong size.
+    Alpha(String),
+    /// A requested frame index does not exist.
+    FrameOutOfRange {
+        /// Requested zero-based frame number.
+        index: u32,
+        /// Number of indexed frames.
+        num_frames: u32,
+    },
+}
+
+impl fmt::Display for AlphaMovieError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(formatter, "AJPM: {self:?}")
+    }
+}
+
+impl std::error::Error for AlphaMovieError {}
+
+#[derive(Clone, Debug)]
+struct FrameRecord {
+    index: u32,
+    left: u16,
+    top: u16,
+    width: u16,
+    height: u16,
+    alpha: Range<usize>,
+    entropy: Range<usize>,
+}
+
+/// Immutable compressed movie and validated frame index.
+#[derive(Clone, Debug)]
+pub struct AlphaMovie {
+    bytes: Arc<[u8]>,
+    metadata: AlphaMovieMetadata,
+    frames: Vec<FrameRecord>,
+    quantization: [[u8; 64]; 3],
+    separate_alpha: bool,
+}
+
+impl AlphaMovie {
+    /// Validates a container and indexes its compressed frame records.
+    ///
+    /// # Errors
+    /// Reports invalid headers, records, rectangles, index bounds or allocations.
+    /// Entropy and zlib contents are validated lazily by [`Self::decode`].
+    pub fn open(bytes: Arc<[u8]>, limits: AlphaMovieLimits) -> Result<Self, AlphaMovieError> {
+        if bytes.get(..4) != Some(b"AJPM") || bytes.len() < 40 {
+            return Err(AlphaMovieError::Format("missing file header"));
+        }
+        if read_u32(&bytes, 8)? != 0 {
+            return Err(AlphaMovieError::Format("unsupported revision"));
+        }
+        let header_size = to_usize(read_u32(&bytes, 12)?)?;
+        let attribute = bytes[36];
+        let separate_alpha = attribute & 1 == 0;
+        if (separate_alpha && (attribute & 2 == 0 || header_size != 168))
+            || (!separate_alpha && header_size != 232)
+            || header_size > bytes.len()
+        {
+            return Err(AlphaMovieError::Format(
+                "invalid attribute or quantization header",
+            ));
+        }
+        let metadata = AlphaMovieMetadata {
+            num_frames: read_u32(&bytes, 20)?,
+            fps_scale: read_u32(&bytes, 24)?,
+            fps_rate: read_u32(&bytes, 28)?,
+            width: read_u16(&bytes, 32)?,
+            height: read_u16(&bytes, 34)?,
+        };
+        if metadata.num_frames == 0
+            || metadata.fps_scale == 0
+            || metadata.fps_rate == 0
+            || metadata.width == 0
+            || metadata.height == 0
+        {
+            return Err(AlphaMovieError::Format(
+                "zero frame count, rate or screen dimensions",
+            ));
+        }
+        let count = to_usize(metadata.num_frames)?;
+        if count > limits.max_frames {
+            return Err(AlphaMovieError::ResourceLimit("frame count"));
+        }
+        let minimum_record = if separate_alpha { 24 } else { 20 };
+        if count > (bytes.len() - header_size) / minimum_record {
+            return Err(AlphaMovieError::Format(
+                "frame count exceeds remaining bytes",
+            ));
+        }
+        let mut quantization = [[0; 64]; 3];
+        for (table, source) in quantization
+            .iter_mut()
+            .zip(bytes[40..header_size].as_chunks::<64>().0.iter())
+        {
+            table.copy_from_slice(source);
+        }
+        let mut frames = Vec::new();
+        frames
+            .try_reserve_exact(count)
+            .map_err(|error| AlphaMovieError::Allocation(error.to_string()))?;
+        let mut position = header_size;
+        for index in 0..metadata.num_frames {
+            let record = read_record(&bytes, position, index, separate_alpha, limits)?;
+            position = record.entropy.end;
+            frames.push(record);
+        }
+        if position != bytes.len() {
+            return Err(AlphaMovieError::Format("data follows final frame"));
+        }
+        Ok(Self {
+            bytes,
+            metadata,
+            frames,
+            quantization,
+            separate_alpha,
+        })
+    }
+
+    /// Returns exact nominal dimensions and rational frame-rate metadata.
+    #[must_use]
+    pub const fn metadata(&self) -> &AlphaMovieMetadata {
+        &self.metadata
+    }
+
+    /// Expands one independently coded frame, without changing a playback cursor.
+    ///
+    /// # Errors
+    /// Reports out-of-range indexes, invalid Huffman or zlib data, and allocation failures.
+    pub fn decode(&self, frame_index: u32) -> Result<AlphaMovieFrame, AlphaMovieError> {
+        let record =
+            self.frames
+                .get(to_usize(frame_index)?)
+                .ok_or(AlphaMovieError::FrameOutOfRange {
+                    index: frame_index,
+                    num_frames: self.metadata.num_frames,
+                })?;
+        let width = usize::from(record.width);
+        let height = usize::from(record.height);
+        let pixels = width
+            .checked_mul(height)
+            .ok_or(AlphaMovieError::ResourceLimit("pixel count overflow"))?;
+        let mut rgba = buffer(
+            pixels
+                .checked_mul(4)
+                .ok_or(AlphaMovieError::ResourceLimit("RGBA size overflow"))?,
+        )?;
+        if pixels != 0 {
+            let mut alpha = if self.separate_alpha {
+                inflate_alpha(&self.bytes[record.alpha.clone()], pixels)?
+            } else {
+                buffer(pixels)?
+            };
+            let mut y = buffer(pixels)?;
+            let mut v = buffer(pixels / 4)?;
+            let mut u = buffer(pixels / 4)?;
+            let mut decoder = entropy::Decoder::new(&self.bytes[record.entropy.clone()]);
+            for row in (0..height).step_by(16) {
+                for col in (0..width).step_by(16) {
+                    let chroma = row / 2 * (width / 2) + col / 2;
+                    decoder.chroma(&self.quantization[1], &mut v[chroma..], width / 2)?;
+                    decoder.chroma(&self.quantization[1], &mut u[chroma..], width / 2)?;
+                    for offset in [0, 8, 8 * width, 8 * width + 8] {
+                        decoder.luma(
+                            &self.quantization[0],
+                            &mut y[row * width + col + offset..],
+                            width,
+                        )?;
+                    }
+                    if !self.separate_alpha {
+                        for offset in [0, 8, 8 * width, 8 * width + 8] {
+                            decoder.luma(
+                                &self.quantization[2],
+                                &mut alpha[row * width + col + offset..],
+                                width,
+                            )?;
+                        }
+                    }
+                }
+            }
+            for row in 0..height {
+                for col in 0..width {
+                    let position = row * width + col;
+                    let chroma = row / 2 * (width / 2) + col / 2;
+                    let luma = i32::from(y[position]);
+                    let blue = i32::from(u[chroma]) - 128;
+                    let red = i32::from(v[chroma]) - 128;
+                    // Full-range 601 coefficients; chroma contributions are quantized independently.
+                    let channels = [
+                        luma + ((91881 * red) >> 16),
+                        luma + ((-22553 * blue) >> 16) + ((-46801 * red) >> 16),
+                        luma + ((116129 * blue) >> 16),
+                    ];
+                    for (output, channel) in rgba[position * 4..][..3].iter_mut().zip(channels) {
+                        *output = u8::try_from(channel.clamp(0, 255))
+                            .map_err(|_| AlphaMovieError::Entropy("RGB sample out of range"))?;
+                    }
+                    rgba[position * 4 + 3] = alpha[position];
+                }
+            }
+        } else if self.separate_alpha {
+            inflate_alpha(&self.bytes[record.alpha.clone()], 0)?;
+        }
+        Ok(AlphaMovieFrame {
+            index: record.index,
+            left: record.left,
+            top: record.top,
+            width: record.width,
+            height: record.height,
+            rgba,
+        })
+    }
+}
+
+fn read_record(
+    bytes: &[u8],
+    position: usize,
+    index: u32,
+    separate: bool,
+    limits: AlphaMovieLimits,
+) -> Result<FrameRecord, AlphaMovieError> {
+    let header_size = if separate { 24 } else { 20 };
+    let header_end = position
+        .checked_add(header_size)
+        .ok_or(AlphaMovieError::Format("frame header overflow"))?;
+    let header = bytes
+        .get(position..header_end)
+        .ok_or(AlphaMovieError::Format("truncated frame header"))?;
+    if &header[..4] != b"FRAM" || read_u32(header, 8)? != index {
+        return Err(AlphaMovieError::Format("invalid frame magic or sequence"));
+    }
+    let record_size = to_usize(read_u32(header, 4)?)?
+        .checked_add(8)
+        .ok_or(AlphaMovieError::Format("frame size overflow"))?;
+    if record_size < header_size {
+        return Err(AlphaMovieError::Format("frame size smaller than header"));
+    }
+    let end = position
+        .checked_add(record_size)
+        .ok_or(AlphaMovieError::Format("frame end overflow"))?;
+    if end > bytes.len() {
+        return Err(AlphaMovieError::Format("truncated frame payload"));
+    }
+    let width = read_u16(header, 16)?;
+    let height = read_u16(header, 18)?;
+    if width != 0 && height != 0 && (width % 16 != 0 || height % 16 != 0) {
+        return Err(AlphaMovieError::Format(
+            "rectangle is not macroblock aligned",
+        ));
+    }
+    let pixels = usize::from(width)
+        .checked_mul(usize::from(height))
+        .ok_or(AlphaMovieError::ResourceLimit("pixel count overflow"))?;
+    if pixels > limits.max_frame_pixels {
+        return Err(AlphaMovieError::ResourceLimit("frame pixels"));
+    }
+    let alpha_size = if separate {
+        to_usize(read_u32(header, 20)?)?
+    } else {
+        0
+    };
+    let entropy_start = header_end
+        .checked_add(alpha_size)
+        .ok_or(AlphaMovieError::Format("alpha size overflow"))?;
+    if entropy_start > end {
+        return Err(AlphaMovieError::Format("alpha exceeds frame payload"));
+    }
+    Ok(FrameRecord {
+        index,
+        left: read_u16(header, 12)?,
+        top: read_u16(header, 14)?,
+        width,
+        height,
+        alpha: header_end..entropy_start,
+        entropy: entropy_start..end,
+    })
+}
+
+fn inflate_alpha(compressed: &[u8], pixels: usize) -> Result<Vec<u8>, AlphaMovieError> {
+    let mut alpha = buffer(
+        pixels
+            .checked_add(1)
+            .ok_or(AlphaMovieError::ResourceLimit("alpha size overflow"))?,
+    )?;
+    let mut inflater = Decompress::new(true);
+    let status = inflater
+        .decompress(compressed, &mut alpha, FlushDecompress::Finish)
+        .map_err(|error| AlphaMovieError::Alpha(error.to_string()))?;
+    if status != Status::StreamEnd
+        || inflater.total_out()
+            != u64::try_from(pixels)
+                .map_err(|_| AlphaMovieError::ResourceLimit("alpha size overflow"))?
+        || inflater.total_in()
+            != u64::try_from(compressed.len())
+                .map_err(|_| AlphaMovieError::ResourceLimit("compressed size overflow"))?
+    {
+        return Err(AlphaMovieError::Alpha(
+            "alpha stream has wrong decoded size or trailing bytes".into(),
+        ));
+    }
+    alpha.truncate(pixels);
+    Ok(alpha)
+}
+
+fn buffer(size: usize) -> Result<Vec<u8>, AlphaMovieError> {
+    let mut bytes = Vec::new();
+    bytes
+        .try_reserve_exact(size)
+        .map_err(|error| AlphaMovieError::Allocation(error.to_string()))?;
+    bytes.resize(size, 0);
+    Ok(bytes)
+}
+
+fn to_usize(value: u32) -> Result<usize, AlphaMovieError> {
+    usize::try_from(value).map_err(|_| AlphaMovieError::Format("size exceeds address space"))
+}
+
+fn read_u32(bytes: &[u8], offset: usize) -> Result<u32, AlphaMovieError> {
+    let slice = bytes
+        .get(offset..offset + 4)
+        .ok_or(AlphaMovieError::Format("truncated integer"))?;
+    Ok(u32::from_le_bytes([slice[0], slice[1], slice[2], slice[3]]))
+}
+
+fn read_u16(bytes: &[u8], offset: usize) -> Result<u16, AlphaMovieError> {
+    let slice = bytes
+        .get(offset..offset + 2)
+        .ok_or(AlphaMovieError::Format("truncated integer"))?;
+    Ok(u16::from_le_bytes([slice[0], slice[1]]))
+}
