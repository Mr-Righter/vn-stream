+#[test]
+fn redundant_zero_run_preserves_negative_dc_idct_rounding() {
+    for attribute in [1, 2] {
+        for redundant_run in [false, true] {
+            let mut bits = "00000000".to_owned();
+            dc_block(&mut bits, -5, false);
+            if redundant_run {
+                bits.truncate(bits.len() - 4);
+                bits.push_str("111111110011010");
+            }
+            dc_block(&mut bits, 5, false);
+            for _ in 0..if attribute == 1 { 6 } else { 2 } {
+                bits.push_str("001010");
+            }
+            while !bits.len().is_multiple_of(8) {
+                bits.push('0');
+            }
+            let entropy: Vec<_> = bits
+                .as_bytes()
+                .chunks(8)
+                .map(|chunk| chunk.iter().fold(0, |byte, bit| (byte << 1) | (bit - b'0')))
+                .collect();
+            let payload = if attribute == 1 {
+                entropy
+            } else {
+                let mut payload = separate_payload(&vec![128; 256]);
+                payload.truncate(payload.len() - zero_entropy(false).len());
+                payload.extend_from_slice(&entropy);
+                payload
+            };
+            let decoder =
+                AlphaMovie::open(Arc::from(movie(attribute, &[(16, 16, payload)])), limits())
+                    .unwrap();
+            let frame = decoder.decode(0).unwrap();
+            for row in 0..16 {
+                for col in 0..16 {
+                    let y = if redundant_run && row < 8 && col < 8 {
+                        127
+                    } else {
+                        128
+                    };
+                    // reference/cpp/plugins/AlphaMovie.cpp:318-330,440-450,851-868:
+                    // DC=-5,q0=1 gives128 on immediate EOB via division, but
+                    // a ZRL then EOB returns17 and invokes rounded IDCT giving127.
+                    assert_eq!(&frame.rgba[(row * 16 + col) * 4..][..4], &[y, y, y, 128]);
+                }
+            }
+        }
+    }
