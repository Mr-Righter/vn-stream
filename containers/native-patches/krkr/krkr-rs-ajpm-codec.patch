+//! AJPM synthetic fixtures; no copyrighted game assets are embedded.
+use std::{io::Write, sync::Arc};
+
+use flate2::{Compression, write::ZlibEncoder};
+use media::alpha_movie::{AlphaMovie, AlphaMovieError, AlphaMovieLimits};
+
+fn limits() -> AlphaMovieLimits {
+    AlphaMovieLimits {
+        max_frames: 8,
+        max_frame_pixels: 1024,
+    }
+}
+
+fn append_u32(bytes: &mut Vec<u8>, value: u32) {
+    bytes.extend_from_slice(&value.to_le_bytes());
+}
+
+fn movie(attribute: u8, frames: &[(u16, u16, Vec<u8>)]) -> Vec<u8> {
+    let header_size = if attribute == 1 { 232_u32 } else { 168 };
+    let mut bytes = b"AJPM".to_vec();
+    for value in [
+        0,
+        0,
+        header_size,
+        0,
+        u32::try_from(frames.len()).unwrap(),
+        1001,
+        30000,
+    ] {
+        append_u32(&mut bytes, value);
+    }
+    bytes.extend_from_slice(&[13, 0, 15, 0, attribute, 0, 0, 0]);
+    bytes.resize(usize::try_from(header_size).unwrap(), 1);
+    for (index, (width, height, payload)) in frames.iter().enumerate() {
+        bytes.extend_from_slice(b"FRAM");
+        append_u32(&mut bytes, u32::try_from(payload.len()).unwrap() + 12);
+        append_u32(&mut bytes, u32::try_from(index).unwrap());
+        for value in [7_u16, 9, *width, *height] {
+            bytes.extend_from_slice(&value.to_le_bytes());
+        }
+        bytes.extend_from_slice(payload);
+    }
+    bytes
+}
+
+fn zero_entropy(block_alpha: bool) -> Vec<u8> {
+    // reference/cpp/plugins/AlphaMovie.cpp:35-99,918-944,1007-1037:
+    // chroma DC0+EOB is 00 00, luma DC0+EOB is 00 1010.
+    let mut bits = "00000000".to_owned();
+    for _ in 0..if block_alpha { 8 } else { 4 } {
+        bits.push_str("001010");
+    }
+    while !bits.len().is_multiple_of(8) {
+        bits.push('0');
+    }
+    bits.as_bytes()
+        .chunks(8)
+        .map(|chunk| chunk.iter().fold(0, |byte, bit| (byte << 1) | (bit - b'0')))
+        .collect()
+}
