+fn dc_block(bits: &mut String, difference: i32, chroma: bool) {
+    let prefixes = if chroma {
+        [
+            "00",
+            "01",
+            "10",
+            "110",
+            "1110",
+            "11110",
+            "111110",
+            "1111110",
+            "11111110",
+            "111111110",
+            "1111111110",
+            "11111111110",
+        ]
+    } else {
+        [
+            "00",
+            "010",
+            "011",
+            "100",
+            "101",
+            "110",
+            "1110",
+            "11110",
+            "111110",
+            "1111110",
+            "11111110",
+            "111111110",
+        ]
+    };
+    let size = usize::try_from(difference.unsigned_abs().ilog2().saturating_add(1)).unwrap();
+    bits.push_str(prefixes[size]);
+    let encoded = if difference < 0 {
+        (1_i32 << size) - 1 + difference
+    } else {
+        difference
+    };
+    for shift in (0..size).rev() {
+        bits.push(if encoded & (1 << shift) == 0 {
+            '0'
+        } else {
+            '1'
+        });
+    }
+    bits.push_str(if chroma { "00" } else { "1010" });
+}
+
+fn colored_entropy(block_alpha: bool) -> Vec<u8> {
+    let mut bits = String::new();
+    // reference/cpp/plugins/AlphaMovie.cpp:918-944,1007-1037:
+    // both chroma components share a predictor, as do luma and block alpha.
+    dc_block(&mut bits, 64, true);
+    dc_block(&mut bits, -128, true);
+    dc_block(&mut bits, 64, false);
+    for _ in 0..3 {
+        bits.push_str("001010");
+    }
+    if block_alpha {
+        dc_block(&mut bits, -64, false);
+        for _ in 0..3 {
+            bits.push_str("001010");
+        }
+    }
+    while !bits.len().is_multiple_of(8) {
+        bits.push('0');
+    }
+    bits.as_bytes()
+        .chunks(8)
+        .map(|chunk| chunk.iter().fold(0, |byte, bit| (byte << 1) | (bit - b'0')))
+        .collect()
+}
