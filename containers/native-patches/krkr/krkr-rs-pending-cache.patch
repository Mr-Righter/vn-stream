+#[test]
+fn trivial_subtree_returns_a_resolved_main_image() {
+    use engine::Rect;
+    use engine::layer_ops::render_layer_subtree;
+
+    let decoder = Arc::new(GatedDecoder::new());
+    let mut pool = DecodePool::new(decoder.clone(), config(1)).expect("pool");
+    let pending = ready_subtree_image(&mut pool, &decoder, "trivial-main", [30, 60, 90, 255]);
+    let mut scene = Scene::default();
+    let window = scene.add_window("trivial input", (2, 2));
+    let image = scene.add_pending_bitmap(2, 2, pending).expect("main image");
+    let root = subtree_layer(&mut scene, window, None, image, Rect::new(0, 0, 2, 2), true);
+    let content = render_layer_subtree(&mut scene, root).expect("trivial content");
+    // reference/cpp/core/visual/LayerIntf.cpp:7673-7752:
+    // the trivial completion returns MainImage with its pixels available.
+    assert_eq!(content, image);
+    // reference/cpp/core/visual/LayerIntf.cpp:7673-7752
+    assert!(scene.bitmap(content).expect("main").pending.is_none());
+    // reference/cpp/core/visual/LayerIntf.cpp:7673-7752
+    assert_eq!(
+        &scene.bitmap(content).expect("main").rgba[..4],
+        &[30, 60, 90, 255]
+    );
+}
