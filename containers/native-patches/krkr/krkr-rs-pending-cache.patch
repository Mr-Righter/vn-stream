+#[test]
+fn subtree_mask_derivation_resolves_the_selected_alpha_plane() {
+    use engine::Rect;
+    use engine::layer_ops::render_layer_subtree;
+
+    let decoder = Arc::new(GatedDecoder::new());
+    let mut pool = DecodePool::new(decoder.clone(), config(1)).expect("pool");
+    let pending = ready_subtree_image(&mut pool, &decoder, "cache-mask", [20, 40, 60, 128]);
+    let mut scene = Scene::default();
+    let window = scene.add_window("mask input", (2, 2));
+    let main = scene.add_bitmap(2, 2, vec![0; 16]);
+    let root = subtree_layer(&mut scene, window, None, main, Rect::new(0, 0, 2, 2), true);
+    let mask = scene.add_pending_bitmap(2, 2, pending).expect("mask image");
+    let child = subtree_layer(
+        &mut scene,
+        window,
+        Some(root),
+        mask,
+        Rect::new(0, 0, 1, 1),
+        true,
+    );
+    scene.layer_mut(child).expect("mask layer").face = 2; // dfMask
+    let content = render_layer_subtree(&mut scene, root).expect("mask composite");
+    // reference/cpp/core/visual/LayerIntf.cpp:7673-7752:
+    // the mask face reads the completed MainImage's alpha plane.
+    assert!(scene.bitmap(mask).expect("mask").pending.is_none());
+    // reference/cpp/core/visual/LayerIntf.cpp:7673-7752
+    assert_eq!(
+        &scene.bitmap(content).expect("cache").rgba[..4],
+        &[128, 128, 128, 255]
+    );
+}
