+#[test]
+fn subtree_composite_resolves_selected_inputs_and_reuses_the_final_signature() {
+    use api::blend::BlendMode;
+    use engine::Rect;
+    use engine::layer_ops::render_layer_subtree;
+
+    let decoder = Arc::new(GatedDecoder::new());
+    let mut pool = DecodePool::new(decoder.clone(), config(1)).expect("pool");
+    let main = ready_subtree_image(&mut pool, &decoder, "cache-main", [30, 60, 90, 255]);
+    let child = ready_subtree_image(&mut pool, &decoder, "cache-child", [200, 40, 60, 255]);
+    let hidden = ready_subtree_image(&mut pool, &decoder, "cache-hidden", [1, 2, 3, 255]);
+    let clipped = ready_subtree_image(&mut pool, &decoder, "cache-clipped", [7, 8, 9, 255]);
+    let unrelated = ready_subtree_image(&mut pool, &decoder, "cache-unrelated", [4, 5, 6, 255]);
+    let mut scene = Scene::default();
+    let window = scene.add_window("cache inputs", (2, 2));
+    let main = scene.add_pending_bitmap(2, 2, main).expect("main image");
+    let root = subtree_layer(&mut scene, window, None, main, Rect::new(0, 0, 2, 2), true);
+    let child = scene.add_pending_bitmap(2, 2, child).expect("child image");
+    let child_layer = subtree_layer(
+        &mut scene,
+        window,
+        Some(root),
+        child,
+        Rect::new(0, 0, 1, 1),
+        true,
+    );
+    scene.layer_mut(child_layer).expect("child").blend = BlendMode::Replace;
+    let hidden = scene
+        .add_pending_bitmap(2, 2, hidden)
+        .expect("hidden image");
+    subtree_layer(
+        &mut scene,
+        window,
+        Some(root),
+        hidden,
+        Rect::new(0, 0, 2, 2),
+        false,
+    );
+    let clipped = scene
+        .add_pending_bitmap(2, 2, clipped)
+        .expect("clipped image");
+    subtree_layer(
+        &mut scene,
+        window,
+        Some(root),
+        clipped,
+        Rect::new(4, 4, 1, 1),
+        true,
+    );
+    let unrelated = scene
+        .add_pending_bitmap(2, 2, unrelated)
+        .expect("unrelated image");
+    let other_window = scene.add_window("unrelated", (2, 2));
+    subtree_layer(
+        &mut scene,
+        other_window,
+        None,
+        unrelated,
+        Rect::new(0, 0, 2, 2),
+        true,
+    );
+    scene.inc_cache_enabled_count(root);
+
+    let content = render_layer_subtree(&mut scene, root).expect("composited cache");
+    // reference/cpp/core/visual/LayerIntf.cpp:7673-7752:
+    // Complete composites the root and the visible child's actual pixels.
+    assert!(scene.bitmap(main).expect("main").pending.is_none());
+    // reference/cpp/core/visual/LayerIntf.cpp:7673-7752
+    assert!(scene.bitmap(child).expect("child").pending.is_none());
+    let image = scene.bitmap(content).expect("cache");
+    // reference/cpp/core/visual/LayerIntf.cpp:7673-7752
+    assert_eq!(&image.rgba[..4], &[200, 40, 60, 255]);
+    // reference/cpp/core/visual/LayerIntf.cpp:7673-7752
+    assert_eq!(&image.rgba[4..8], &[30, 60, 90, 255]);
+    let generation = image.content_generation;
+    let pixels = image.rgba.clone();
+    let again = render_layer_subtree(&mut scene, root).expect("reused cache");
+    // reference/cpp/core/visual/LayerIntf.cpp:7688-7728:
+    // an unchanged completed cache needs no recomposition.
+    assert_eq!(again, content);
+    // reference/cpp/core/visual/LayerIntf.cpp:7688-7728
+    assert_eq!(
+        scene.bitmap(again).expect("cache").content_generation,
+        generation
+    );
+    // reference/cpp/core/visual/LayerIntf.cpp:7688-7728
+    assert_eq!(scene.bitmap(again).expect("cache").rgba, pixels);
+    for id in [hidden, clipped, unrelated] {
+        // reference/cpp/core/visual/LayerIntf.cpp:7673-7752:
+        // a subtree completion reads no hidden, clipped or unrelated image.
+        assert!(
+            scene
+                .bitmap(id)
+                .expect("unselected image")
+                .pending
+                .is_some()
+        );
+        // reference/cpp/core/visual/LayerIntf.cpp:7673-7752
+        assert!(scene.bitmap(id).expect("unselected image").rgba.is_empty());
+    }
+}
