+// ---------------------------------------------------------------------------
+// Pending inputs of the subtree compositor
+// ---------------------------------------------------------------------------
+
+fn ready_subtree_image(
+    pool: &mut DecodePool,
+    decoder: &GatedDecoder,
+    hint: &str,
+    color: [u8; 4],
+) -> PendingImage {
+    decoder.gate(hint).open();
+    let pass: Arc<dyn Fn(DecodedImage) -> Result<DecodedImage, String> + Send + Sync> =
+        Arc::new(move |mut image| {
+            for pixel in image.rgba.as_chunks_mut::<4>().0 {
+                pixel.copy_from_slice(&color);
+            }
+            Ok(image)
+        });
+    let (_, pending) = pool
+        .submit(
+            Arc::from(b"payload".as_slice()),
+            Some(hint.to_string()),
+            PIXELS.len() as u64,
+            Some(pass),
+        )
+        .expect("subtree image job");
+    // reference/cpp/core/visual/GraphicsLoaderIntf.cpp:1952-1960:
+    // the completed image is available before the composite reads it.
+    assert!(matches!(pending.await_ready(), ImageOutcome::Ready(_)));
+    pending
+}
+
+fn subtree_layer(
+    scene: &mut Scene,
+    window: u32,
+    parent: Option<u32>,
+    bitmap: u32,
+    rect: engine::Rect,
+    visible: bool,
+) -> u32 {
+    let id = scene.add_layer(window, parent);
+    let layer = scene.layer_mut(id).expect("subtree layer");
+    layer.bitmap = Some(bitmap);
+    layer.rect = rect;
+    layer.visible = visible;
+    layer.image_width = rect.w;
+    layer.image_height = rect.h;
+    id
+}
