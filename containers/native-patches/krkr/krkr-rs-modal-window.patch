+//! Modal windows preserve the synchronous caller until a genuine close.
+//! reference/cpp/core/environ/impl/TVPWindow.cpp:498-524,988-1000
+
+mod common;
+
+use compat::CompatError;
+use std::cell::Cell;
+use std::rc::{Rc, Weak};
+use tjs::TjsValue;
+
+use common::{Env, vm_lock};
+use platform::{InputEvent, MouseButton, PhysicalKey, PlatformEvent};
+
+fn live(weak: &Weak<Env>) -> Result<Rc<Env>, CompatError> {
+    weak.upgrade()
+        .ok_or_else(|| CompatError::Engine("test host expired".to_owned()))
+}
+
+fn execute(env: &Env, script: &str) -> Result<(), CompatError> {
+    env.engine()
+        .exec_script(script, "modal-test")
+        .map(|_| ())
+        .map_err(|error| CompatError::Engine(error.to_string()))
+}
+
+fn integer(env: &Env, expression: &str) -> Result<i64, CompatError> {
+    match env.eval(expression).map_err(CompatError::Engine)? {
+        TjsValue::Integer(value) => Ok(value),
+        other => Err(CompatError::Engine(format!(
+            "expected integer for {expression}, got {other:?}"
+        ))),
+    }
+}
+
+#[test]
+fn modal_close_preserves_result_until_the_caller_invalidates() {
+    let _lock = vm_lock();
+    let env = Rc::new(Env::new());
+    env.run("var main = new Window(); main.visible=true; var dialog=new Window(); var contents=new Layer(dialog, null); dialog.add(contents); var result=false; var resumed=false;");
+    let weak = Rc::downgrade(&env);
+    let dispatched = Rc::new(Cell::new(None));
+    let seen = Rc::clone(&dispatched);
+    env.modal_driver(Some(Rc::new(move |id| {
+        let env = live(&weak)?;
+        let before = (
+            compat::modal_active(&env.compat_context(), id),
+            integer(&env, "resumed")?,
+            integer(&env, "dialog.visible")?,
+        );
+        execute(&env, "result=true; dialog.close();")?;
+        seen.set(Some((
+            before,
+            compat::modal_active(&env.compat_context(), id),
+            integer(&env, "isvalid dialog")?,
+            integer(&env, "isvalid contents")?,
+        )));
+        Ok(())
+    })));
+    env.run("dialog.showModal(); resumed=true; var accepted=result; invalidate dialog;");
+    // reference/cpp/core/environ/impl/TVPWindow.cpp:498-524 — only the
+    // completed dialog allows the suspended script sequence to continue.
+    assert_eq!(dispatched.get(), Some(((true, 0, 1), false, 1, 1)));
+    assert_eq!(env.eval_int("accepted"), 1);
+    assert_eq!(env.eval_int("resumed"), 1);
+    assert_eq!(env.eval_int("isvalid contents"), 0);
+}
+
+#[test]
+fn cancelling_a_modal_preserves_false_and_restores_the_parent_window() {
+    let _lock = vm_lock();
+    let env = Rc::new(Env::new());
+    env.run("var main=new Window(); var dialog=new Window(); var result=false;");
+    let weak = Rc::downgrade(&env);
+    env.modal_driver(Some(Rc::new(move |_id| {
+        let env = live(&weak)?;
+        execute(&env, "dialog.close();")?;
+        Ok(())
+    })));
+    env.run("dialog.showModal(); var accepted=result;");
+    // reference/cpp/core/environ/impl/TVPWindow.cpp:498-524,988-1000 —
+    // cancelling closes the modal without fabricating an affirmative result.
+    assert_eq!(env.eval_int("accepted"), 0);
+    assert_eq!(env.eval_int("main.visible"), 1);
+    assert_eq!(env.eval_int("dialog.visible"), 0);
+}
+
+#[test]
+fn modal_driver_errors_release_the_modal_scope() {
+    let _lock = vm_lock();
+    let env = Rc::new(Env::new());
+    env.run("var main=new Window(); main.visible=true; var dialog=new Window();");
+    let modal_id = Rc::new(Cell::new(None));
+    let observed = Rc::clone(&modal_id);
+    env.modal_driver(Some(Rc::new(move |id| {
+        observed.set(Some(id));
+        Err(compat::CompatError::Engine("modal test stop".to_owned()))
+    })));
+    let error = env.error("dialog.showModal()");
+    // reference/cpp/core/environ/impl/TVPWindow.cpp:498-524 — the modal
+    // lifetime cannot survive an interrupted modal host loop.
+    assert!(error.contains("modal test stop"));
+    assert!(!compat::modal_active(
+        &env.compat_context(),
+        modal_id.get().expect("driver entered")
+    ));
+}
+
+#[test]
+fn modal_keyboard_and_positioned_pointer_do_not_reach_the_background() {
+    let _lock = vm_lock();
+    let env = Rc::new(Env::new());
+    env.run(
+        r#"
+        class Keys extends Window {
+            var keys=0;
+            function Keys() { super.Window(); visible=true; }
+            function onKeyDown(key, shift) { keys++; }
+        }
+        class Button extends Layer {
+            function Button(win, parent) { super.Layer(win, parent); }
+            var clicks=0; var clickX=-1; var clickY=-1;
+            function onClick(x, y) { clicks++; clickX=x; clickY=y; }
+        }
+        var main=new Keys(); main.setPos(100, 80); main.setInnerSize(640,480);
+        var background=new Button(main, null); background.setSize(640,480); background.hitThreshold=0;
+        var dialog=new Keys(); dialog.setPos(240, 180); dialog.setInnerSize(200,100);
+        var button=new Button(dialog, null); button.setSize(200,100); button.visible=true; button.hitThreshold=0;
+    "#,
+    );
+    let weak = Rc::downgrade(&env);
+    let observed = Rc::new(Cell::new(None));
+    let captured = Rc::clone(&observed);
+    env.modal_driver(Some(Rc::new(move |id| {
+        let env = live(&weak)?;
+        let mut ctx = env.compat_context();
+        let mut adapter = compat::EventAdapter::with_dispatch_budget(std::time::Duration::MAX);
+        adapter.begin_input_frame(&mut ctx);
+        adapter.dispatch_frame(
+            &mut ctx,
+            &[
+                PlatformEvent::Input(InputEvent::Key {
+                    code: PhysicalKey::KeyA,
+                    pressed: true,
+                }),
+                PlatformEvent::Input(InputEvent::PointerMoved { x: 150.0, y: 110.0 }),
+                PlatformEvent::Input(InputEvent::MouseButton {
+                    button: MouseButton::Left,
+                    pressed: true,
+                }),
+                PlatformEvent::Input(InputEvent::MouseButton {
+                    button: MouseButton::Left,
+                    pressed: false,
+                }),
+                PlatformEvent::Input(InputEvent::PointerMoved { x: 20.0, y: 20.0 }),
+                PlatformEvent::Input(InputEvent::MouseButton {
+                    button: MouseButton::Left,
+                    pressed: true,
+                }),
+                PlatformEvent::Input(InputEvent::MouseButton {
+                    button: MouseButton::Left,
+                    pressed: false,
+                }),
+            ],
+        )?;
+        adapter.end_input_frame(&mut ctx);
+        captured.set(Some((
+            compat::modal_active(&ctx, id),
+            integer(&env, "main.keys")?,
+            integer(&env, "dialog.keys")?,
+            integer(&env, "background.clicks")?,
+            integer(&env, "button.clicks")?,
+            integer(&env, "button.clickX")?,
+            integer(&env, "button.clickY")?,
+        )));
+        execute(&env, "dialog.close();")?;
+        Ok(())
+    })));
+    env.run("dialog.showModal();");
+    // reference/cpp/core/environ/impl/TVPWindow.cpp:498-524 — input is
+    // confined to the modal client, with the same origin as its pixels.
+    assert_eq!(observed.get(), Some((true, 0, 1, 0, 1, 10, 10)));
+
+    env.dispatch_events(&[PlatformEvent::Input(InputEvent::Key {
+        code: PhysicalKey::KeyB,
+        pressed: true,
+    })]);
+    // reference/cpp/core/environ/impl/TVPWindow.cpp:475-524 — returning
+    // from a modal restores the previous live window's input domain.
+    assert_eq!(env.eval_int("main.keys"), 1);
+    assert_eq!(env.eval_int("dialog.keys"), 1);
+}
+
+#[test]
+fn returning_from_a_modal_discards_the_triggering_input_batch() {
+    let _lock = vm_lock();
+    let env = Rc::new(Env::new());
+    env.run(
+        r#"
+        class Main extends Window {
+            function Main() { super.Window(); visible=true; }
+            var keys=0;
+            function onKeyDown(key, shift) { keys++; dialog.showModal(); }
+        }
+        var main=new Main(); var dialog=new Window(); dialog.visible=false;
+    "#,
+    );
+    let weak = Rc::downgrade(&env);
+    let calls = Rc::new(Cell::new(0));
+    let count = Rc::clone(&calls);
+    env.modal_driver(Some(Rc::new(move |_id| {
+        count.set(count.get() + 1);
+        let env = live(&weak)?;
+        execute(&env, "dialog.close();")?;
+        Ok(())
+    })));
+    env.dispatch_events(&[
+        PlatformEvent::Input(InputEvent::Key {
+            code: PhysicalKey::KeyA,
+            pressed: true,
+        }),
+        PlatformEvent::Input(InputEvent::Key {
+            code: PhysicalKey::KeyB,
+            pressed: true,
+        }),
+    ]);
+    // reference/cpp/core/visual/impl/WindowImpl.cpp:1505-1512 — stale
+    // input queued for the old window is cleared before a modal loop.
+    assert_eq!(env.eval_int("main.keys"), 1);
+    assert_eq!(calls.get(), 1);
+}
+
+#[test]
+fn nested_modal_scopes_restore_the_waiting_outer_window() {
+    let _lock = vm_lock();
+    let env = Rc::new(Env::new());
+    env.run(
+        "var main=new Window(); var outer=new Window(); var inner=void; var innerAccepted=false;",
+    );
+    let weak = Rc::downgrade(&env);
+    let restored = Rc::new(Cell::new(None));
+    let observation = Rc::clone(&restored);
+    let depth = Rc::new(Cell::new(0));
+    let nesting = Rc::clone(&depth);
+    env.modal_driver(Some(Rc::new(move |id| {
+        let env = live(&weak)?;
+        if nesting.get() == 0 {
+            nesting.set(1);
+            execute(&env, "inner=new Window(); inner.showModal();")?;
+            // reference/cpp/core/environ/impl/TVPWindow.cpp:498-524 —
+            // the outer dialog remains modal until its own close completes.
+            observation.set(Some((
+                compat::modal_active(&env.compat_context(), id),
+                integer(&env, "innerAccepted")?,
+            )));
+            execute(&env, "outer.close();")?;
+        } else {
+            execute(&env, "innerAccepted=true; inner.close();")?;
+        }
+        Ok(())
+    })));
+    env.run("outer.showModal();");
+    // reference/cpp/core/environ/impl/TVPWindow.cpp:475-524 — closing
+    // nested dialogs restores the previous live window in order.
+    assert_eq!(restored.get(), Some((true, 1)));
+    assert_eq!(env.eval_int("main.visible"), 1);
+    assert_eq!(env.eval_int("outer.visible"), 0);
+    assert_eq!(env.eval_int("inner.visible"), 0);
+}
