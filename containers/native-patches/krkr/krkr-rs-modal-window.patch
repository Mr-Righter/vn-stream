@@ -0,0 +1,140 @@
+//! Modal execution policy and the host-owned frame driver.
+#![allow(unsafe_code)]
+
+use std::rc::Rc;
+
+use crate::natives::visual::common::{scene_mut, scene_ref};
+use crate::{CompatCtx, CompatError, CompatServices};
+
+/// Same-thread host callback that services a window until its modal wait ends.
+pub type ModalDriver = Rc<dyn Fn(u32) -> Result<(), CompatError>>;
+
+struct ModalEntry {
+    window: u32,
+    previous: Option<u32>,
+    completed: bool,
+}
+
+#[derive(Default)]
+struct ModalState {
+    driver: Option<ModalDriver>,
+    stack: Vec<ModalEntry>,
+    input_epoch: u64,
+}
+
+pub(crate) fn install_driver(services: &CompatServices, driver: Option<ModalDriver>) {
+    services.state::<ModalState>().driver = driver;
+}
+
+/// Whether the window is still waiting for a modal close.
+pub fn modal_active(ctx: &CompatCtx, window: u32) -> bool {
+    // SAFETY: the context is installed for the live single-threaded host.
+    let services = unsafe { ctx.services() };
+    let pending = services
+        .state::<ModalState>()
+        .stack
+        .iter()
+        .any(|entry| entry.window == window && !entry.completed);
+    pending && scene_ref(ctx).is_ok_and(|scene| scene.window(window).is_some_and(|w| w.visible))
+}
+
+pub(crate) fn active_window(ctx: &CompatCtx) -> Option<u32> {
+    // SAFETY: the context is installed for the live single-threaded host.
+    unsafe { ctx.services() }
+        .state::<ModalState>()
+        .stack
+        .last()
+        .map(|entry| entry.window)
+}
+
+pub(crate) fn input_epoch(ctx: &CompatCtx) -> u64 {
+    // SAFETY: the context is installed for the live single-threaded host.
+    unsafe { ctx.services() }.state::<ModalState>().input_epoch
+}
+
+pub(crate) fn advance_input_epoch(ctx: &CompatCtx) {
+    // SAFETY: the context is installed for the live single-threaded host.
+    let services = unsafe { ctx.services() };
+    let mut state = services.state::<ModalState>();
+    state.input_epoch = state.input_epoch.wrapping_add(1);
+}
+
+pub(crate) fn finish_window(ctx: &CompatCtx, window: u32) -> bool {
+    // SAFETY: the context is installed for the live single-threaded host.
+    let services = unsafe { ctx.services() };
+    let mut state = services.state::<ModalState>();
+    let Some(entry) = state
+        .stack
+        .iter_mut()
+        .rev()
+        .find(|entry| entry.window == window)
+    else {
+        return false;
+    };
+    entry.completed = true;
+    state.input_epoch = state.input_epoch.wrapping_add(1);
+    true
+}
+
+pub(crate) fn run_modal(ctx: &CompatCtx, window: u32) -> Result<(), CompatError> {
+    let driver = {
+        // SAFETY: the context is installed for the live single-threaded host.
+        let services = unsafe { ctx.services() };
+        let state = services.state::<ModalState>();
+        if state.stack.iter().any(|entry| entry.window == window) {
+            return Err(CompatError::Engine("Window is already modal".to_owned()));
+        }
+        state.driver.clone().ok_or_else(|| {
+            CompatError::Engine("Window.showModal: no modal host is attached".to_owned())
+        })?
+    };
+    let previous = {
+        let scene = scene_mut(ctx).map_err(CompatError::Engine)?;
+        let previous = scene
+            .windows
+            .iter()
+            .rev()
+            .find(|w| w.visible && w.id != window)
+            .map(|w| w.id);
+        let dialog = scene.window_mut(window).ok_or_else(|| {
+            CompatError::Engine("Window.showModal: this window is not constructed".to_owned())
+        })?;
+        dialog.visible = true;
+        scene.bring_window_to_front(window);
+        previous
+    };
+    {
+        // SAFETY: the context is installed for the live single-threaded host.
+        let services = unsafe { ctx.services() };
+        services.state::<ModalState>().stack.push(ModalEntry {
+            window,
+            previous,
+            completed: false,
+        });
+    }
+    let outcome = crate::clear_modal_input(ctx).and_then(|()| driver(window));
+    let still_active = modal_active(ctx, window);
+    let previous = {
+        // SAFETY: the context is installed for the live single-threaded host.
+        let services = unsafe { ctx.services() };
+        let mut state = services.state::<ModalState>();
+        state.stack.pop().and_then(|entry| entry.previous)
+    };
+    {
+        let scene = scene_mut(ctx).map_err(CompatError::Engine)?;
+        if let Some(dialog) = scene.window_mut(window) {
+            dialog.visible = false;
+        }
+        if let Some(previous) = previous.filter(|id| scene.window(*id).is_some_and(|w| w.visible)) {
+            scene.bring_window_to_front(previous);
+        }
+    }
+    crate::clear_modal_input(ctx)?;
+    outcome?;
+    if still_active {
+        return Err(CompatError::Engine(
+            "Window.showModal: host returned before the window closed".to_owned(),
+        ));
+    }
+    Ok(())
+}
