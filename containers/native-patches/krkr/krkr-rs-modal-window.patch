+const DIALOG: &str = r#"
+var resumed = 0, answer = -1, active = void, cancelled = 0;
+class Dialog extends Window {
+    var result = false;
+    var surface = void;
+    function Dialog() {
+        super.Window();
+        setInnerSize(80, 60);
+        surface = new Layer(this, null);
+        surface.setSize(80, 60);
+        surface.visible = true;
+    }
+    function onKeyDown(key, shift) {
+        result = key == 13;
+        close();
+    }
+}
+function ask() {
+    active = new Dialog();
+    active.showModal();
+    answer = int active.result;
+    invalidate active;
+    resumed++;
+}
+"#;
+
+struct DiagnosticLog;
+
+impl log::Log for DiagnosticLog {
+    fn enabled(&self, metadata: &log::Metadata) -> bool {
+        metadata.level() <= log::Level::Warn
+    }
+
+    fn log(&self, record: &log::Record) {
+        if self.enabled(record.metadata()) {
+            eprintln!("{}", record.args());
+        }
+    }
+
+    fn flush(&self) {}
+}
+
+struct Harness {
+    vm: VmHost,
+    scene: Box<Scene>,
+    timer: Box<TimerState>,
+    clock: Box<FrameClock>,
+    _input: Box<InputState>,
+}
+
+impl Harness {
+    fn new() -> Self {
+        static LOG: DiagnosticLog = DiagnosticLog;
+        static INSTALL: Once = Once::new();
+        INSTALL.call_once(|| {
+            log::set_logger(&LOG).expect("install test diagnostics");
+            log::set_max_level(log::LevelFilter::Warn);
+        });
+        let mut scene = Box::<Scene>::default();
+        let mut timer = Box::new(TimerState::new());
+        let mut clock = Box::new(FrameClock::new());
+        let mut input = Box::new(InputState::new());
+        let vm = VmHost::with_default_services(|services| {
+            // SAFETY: all attached values are boxed, retain their addresses,
+            // and are declared after the VM in Harness so they outlive it.
+            unsafe {
+                services.attach_scene(scene.as_mut());
+                services.attach_timer(timer.as_mut());
+                services.attach_clock(clock.as_mut());
+                services.attach_input(input.as_mut());
+            }
