diff --git a/crates/app/tests/modal_window.rs b/crates/app/tests/modal_window.rs
new file mode 100644
--- /dev/null
+++ b/crates/app/tests/modal_window.rs
@@ -0,0 +1,237 @@
+//! Modal windows retain their synchronous caller while host frames keep drawing.
+//!
+//! The modal form pumps drawing and input until its close result is set
+//! (`reference/cpp/core/environ/impl/TVPWindow.cpp:498-524,988-1000`).
+//! These fixtures contain no game assets and exercise that contract through
+//! the same host, script events, projection and CPU presentation as a game.
+
+use std::path::PathBuf;
+
+use app::{GameHost, Host, HostConfig, InjectedFrameTime};
+use platform::{InputEvent, MouseButton, PhysicalKey, PlatformEvent};
+use testkit::vm_lock;
+use tjs::TjsValue;
+
+const SCRIPT: &str = r#"
+var resumed = 0;
+var chosen = -1;
+var backgroundClicks = 0;
+var backgroundKeys = 0;
+var dialog = null;
+var mainWindow = new Window();
+mainWindow.setSize(320, 240);
+mainWindow.setPos(0, 0);
+mainWindow.visible = true;
+var background = new Layer(mainWindow, null);
+background.setSize(320, 240);
+background.setImageSize(320, 240);
+background.fillRect(0, 0, 320, 240, 0xff123456);
+background.visible = true;
+background.hitType = 0;
+background.hitThreshold = 0;
+background.focusable = true;
+mainWindow.focusedLayer = background;
+background.onMouseUp = function(x, y, button, shift) { backgroundClicks++; };
+background.onKeyDown = function(key, shift, process) { backgroundKeys++; };
+
+class DialogFace extends Layer {
+    var shell;
+    function DialogFace(win) {
+        super.Layer(win, null);
+        shell = win;
+        setSize(128, 80);
+        setImageSize(128, 80);
+        fillRect(0, 0, 128, 80, 0xffcc2200);
+        visible = true;
+        hitType = 0;
+        hitThreshold = 0;
+        focusable = true;
+    }
+    function onMouseUp(x, y, button, shift) {
+        if(button == 0) {
+            shell.result = x < 64;
+            shell.close();
+        }
+    }
+    function onKeyDown(key, shift, process) {
+        if(key == 13 || key == 27) {
+            shell.result = key == 13;
+            shell.close();
+        }
+    }
+}
+class DialogWindow extends Window {
+    var result = false;
+    var face;
+    function DialogWindow() {
+        super.Window();
+        setSize(128, 80);
+        setPos(96, 80);
+        visible = false;
+        face = new DialogFace(this);
+        add(face);
+        focusedLayer = face;
+    }
+}
+var opener = new Timer(function() {
+    opener.enabled = false;
+    dialog = new DialogWindow();
+    dialog.showModal();
+    chosen = dialog.result ? 1 : 0;
+    resumed++;
+    invalidate dialog;
+}, '');
+opener.interval = 10;
+opener.enabled = true;
+"#;
+
+struct Fixture {
+    game: GameHost,
+    directory: PathBuf,
+}
+
+impl Fixture {
+    fn open(tag: &str) -> Self {
+        let directory = std::env::temp_dir().join(format!(
+            "krkr-modal-{tag}-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .expect("clock after epoch")
+                .as_nanos()
+        ));
+        std::fs::create_dir_all(&directory).expect("fixture directory");
+        std::fs::write(directory.join("startup.tjs"), SCRIPT).expect("fixture script");
+        let mut host =
+            Host::new(HostConfig::headless().with_cpu_presentation(true)).expect("headless host");
+        host.resize((320, 240)).expect("fixture surface");
+        let game = GameHost::open(host, Vec::new(), directory.clone()).expect("open fixture");
+        Self { game, directory }
+    }
+
+    fn frame(&mut self, events: &[PlatformEvent]) {
+        self.game
+            .step(&InjectedFrameTime::new(10.0), events)
+            .expect("modal frame");
+    }
+
+    fn integer(&self, expression: &str) -> i64 {
+        match self
+            .game
+            .vm()
+            .eval(expression, "modal-test")
+            .expect("read state")
+        {
+            TjsValue::Integer(value) => value,
+            other => panic!("expected integer for {expression}, got {other:?}"),
+        }
+    }
+
+    fn pixel(&self, x: usize, y: usize) -> [u8; 4] {
+        self.game
+            .host()
+            .with_presented_frame(|frame| {
+                let offset = (y * usize::try_from(frame.width).expect("frame width") + x) * 4;
+                frame.pixels[offset..offset + 4]
+                    .try_into()
+                    .expect("RGBA pixel")
+            })
+            .expect("host presented a frame")
+    }
+
+    fn click(&mut self, x: f32, y: f32) {
+        self.frame(&[PlatformEvent::Input(InputEvent::PointerMoved { x, y })]);
+        self.frame(&[PlatformEvent::Input(InputEvent::MouseButton {
+            button: MouseButton::Left,
+            pressed: true,
+        })]);
+        self.frame(&[PlatformEvent::Input(InputEvent::MouseButton {
+            button: MouseButton::Left,
+            pressed: false,
+        })]);
+        self.frame(&[]);
+    }
+}
+
+impl Drop for Fixture {
+    fn drop(&mut self) {
+        match std::fs::remove_dir_all(&self.directory) {
+            Ok(()) => {}
+            Err(error) => eprintln!("cannot clean modal fixture: {error}"),
+        }
+    }
+}
+
+#[test]
+fn modal_dialog_presents_before_the_caller_resumes() {
+    let _lock = vm_lock();
+    let mut fixture = Fixture::open("presentation");
+    fixture.frame(&[]);
+
+    // reference/cpp/core/environ/impl/TVPWindow.cpp:498-524: show/raise then
+    // keep the caller waiting while the form continues drawing and receiving input.
+    assert_eq!(fixture.integer("resumed"), 0);
+    assert_eq!(fixture.integer("chosen"), -1);
+    assert_eq!(fixture.game.scene().windows.len(), 2);
+    assert_eq!(fixture.pixel(10, 10), [0x12, 0x34, 0x56, 255]);
+    assert_eq!(fixture.pixel(112, 96), [0xcc, 0x22, 0x00, 255]);
+
+    fixture.frame(&[]);
+    // reference/cpp/core/environ/impl/TVPWindow.cpp:509-524: idle frames cannot
+    // finish the modal call or destroy the dialog before a close result exists.
+    assert_eq!(fixture.integer("resumed"), 0);
+    assert_eq!(fixture.pixel(112, 96), [0xcc, 0x22, 0x00, 255]);
+}
+
+#[test]
+fn pointer_yes_and_no_return_the_dialog_result_at_its_client_origin() {
+    let _lock = vm_lock();
+    for (name, x, expected) in [("yes", 112.0, 1), ("no", 192.0, 0)] {
+        let mut fixture = Fixture::open(name);
+        fixture.frame(&[]);
+        fixture.click(x, 96.0);
+
+        // reference/cpp/core/environ/impl/TVPWindow.cpp:498-524,988-1000: a
+        // close result releases the suspended caller, which can read its result.
+        assert_eq!(fixture.integer("resumed"), 1, "{name}");
+        assert_eq!(fixture.integer("chosen"), expected, "{name}");
+        assert_eq!(fixture.integer("backgroundClicks"), 0, "{name}");
+        assert_eq!(fixture.game.scene().windows.len(), 1, "{name}");
+    }
+}
+
+#[test]
+fn modal_input_excludes_background_and_escape_cancels() {
+    let _lock = vm_lock();
+    let mut fixture = Fixture::open("cancel");
+    fixture.frame(&[]);
+    fixture.click(16.0, 16.0);
+
+    // reference/cpp/core/environ/impl/TVPWindow.cpp:498-524: the background
+    // window is not the current input window while the modal form is active.
+    assert_eq!(fixture.integer("backgroundClicks"), 0);
+    assert_eq!(fixture.integer("resumed"), 0);
+    fixture.frame(&[PlatformEvent::Input(InputEvent::Key {
+        code: PhysicalKey::Escape,
+        pressed: true,
+    })]);
+    fixture.frame(&[]);
+
+    // reference/cpp/core/environ/impl/TVPWindow.cpp:988-1000: closing the
+    // modal form finishes the pending invocation without an affirmative result.
+    assert_eq!(fixture.integer("chosen"), 0);
+    assert_eq!(fixture.integer("resumed"), 1);
+    assert_eq!(fixture.integer("backgroundKeys"), 0);
+
+    fixture.frame(&[PlatformEvent::Input(InputEvent::Key {
+        code: PhysicalKey::Escape,
+        pressed: false,
+    })]);
+    fixture.frame(&[PlatformEvent::Input(InputEvent::Key {
+        code: PhysicalKey::KeyA,
+        pressed: true,
+    })]);
+    // reference/cpp/core/environ/impl/TVPWindow.cpp:475-496: after a modal
+    // form ends, input returns to the active background window and its focus.
+    assert_eq!(fixture.integer("backgroundKeys"), 1);
+}
