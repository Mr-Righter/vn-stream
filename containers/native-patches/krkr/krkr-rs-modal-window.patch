diff --git a/crates/compat/tests/system_continuous_modal.rs b/crates/compat/tests/system_continuous_modal.rs
new file mode 100644
--- /dev/null
+++ b/crates/compat/tests/system_continuous_modal.rs
@@ -0,0 +1,107 @@
+//! Continuous-event delivery does not re-enter while a modal callback waits.
+//!
+//! reference/cpp/core/event/EventIntf.cpp:868-890
+
+mod common;
+
+use std::cell::Cell;
+use std::rc::Rc;
+
+use compat::CompatError;
+use tjs::TjsValue;
+
+use common::{Env, vm_lock};
+
+fn observed_integer(env: &Env, expression: &str) -> Result<i64, CompatError> {
+    match env.engine().eval(expression, "modal-observation") {
+        Ok(TjsValue::Integer(value)) => Ok(value),
+        Ok(other) => Err(CompatError::Engine(format!(
+            "expected integer for {expression}, got {other:?}"
+        ))),
+        Err(error) => Err(CompatError::Engine(error.to_string())),
+    }
+}
+
+fn poll(env: &Env) -> bool {
+    compat::continuous_handler_poll(&mut env.compat_context()).expect("continuous poll")
+}
+
+#[test]
+fn modal_timer_can_remove_the_suspended_continuous_handler() {
+    let _lock = vm_lock();
+    let env = Rc::new(Env::new());
+    env.run(
+        r#"
+        var aCalls = 0, bCalls = 0, resumed = 0;
+        var dialog = new Window();
+        var closer = new Timer(function() {
+            closer.enabled = false;
+            System.removeContinuousHandler(first);
+            dialog.close();
+        }, '');
+        closer.interval = 10;
+        closer.enabled = true;
+        function first(tick) {
+            aCalls++;
+            if(aCalls == 1) {
+                dialog.showModal();
+                resumed++;
+            }
+        }
+        function second(tick) { bCalls++; }
+        System.addContinuousHandler(first);
+        System.addContinuousHandler(second);
+        "#,
+    );
+    let observed = Rc::new(Cell::new(None));
+    let nested = Rc::clone(&observed);
+    let weak = Rc::downgrade(&env);
+    env.modal_driver(Some(Rc::new(move |_window| {
+        let env = weak
+            .upgrade()
+            .ok_or_else(|| CompatError::Engine("modal test host stopped".to_owned()))?;
+        compat::continuous_handler_poll(&mut env.compat_context())?;
+        nested.set(Some((
+            observed_integer(&env, "aCalls")?,
+            observed_integer(&env, "bCalls")?,
+        )));
+        env.advance_time(16);
+        env.deliver_due_timers();
+        compat::timer_poll(&mut env.compat_context())?;
+        Ok(())
+    })));
+
+    assert!(poll(&env));
+    // reference/cpp/core/event/EventIntf.cpp:868-890: an already active
+    // continuous delivery returns before invoking another handler.
+    assert_eq!(observed.get(), Some((1, 0)));
+    // reference/cpp/core/event/EventIntf.cpp:868-890: modal pumping does not
+    // advance the active handler list; the outer pass resumes exactly once.
+    assert_eq!(env.eval_int("aCalls"), 1);
+    assert_eq!(env.eval_int("resumed"), 1);
+    assert_eq!(env.eval_int("bCalls"), 1);
+    assert!(poll(&env));
+    // reference/cpp/core/event/EventIntf.cpp:868-890: removal during the
+    // callback stays effective after the delivery guard has been released.
+    assert_eq!(env.eval_int("aCalls"), 1);
+    assert_eq!(env.eval_int("bCalls"), 2);
+}
+
+#[test]
+fn a_throwing_callback_does_not_leave_continuous_delivery_locked() {
+    let _lock = vm_lock();
+    let env = Env::new();
+    env.run(
+        "var failures=0, calls=0; \
+         function failing(tick) { failures++; throw 'continuous fixture error'; } \
+         function succeeding(tick) { calls++; } \
+         System.addContinuousHandler(failing); \
+         System.addContinuousHandler(succeeding);",
+    );
+    assert!(poll(&env));
+    assert!(poll(&env));
+    // reference/cpp/core/event/EventIntf.cpp:868-890: exception cleanup clears
+    // the processing guard; a later pass can deliver the surviving handler.
+    assert_eq!(env.eval_int("failures"), 1);
+    assert_eq!(env.eval_int("calls"), 2);
+}
