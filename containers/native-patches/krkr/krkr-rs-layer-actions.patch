+++ b/crates/compat/tests/layer_action_owner.rs
@@ -0,0 +1,187 @@
+//! Layer default events dispatch to their constructor's action owner.
+//! reference/cpp/core/visual/LayerIntf.cpp:476,9970-10472
+
+mod common;
+
+use std::cell::Cell;
+use std::rc::Rc;
+
+use common::{Env, vm_lock};
+use compat::CompatError;
+use platform::{InputEvent, MouseButton, PlatformEvent};
+
+#[test]
+fn native_click_preserves_target_and_named_argument_types() {
+    let _lock = vm_lock();
+    let env = Env::new();
+    env.run(
+        r#"
+        var owner=new Window(); var button=new Layer(owner,null);
+        var count=0; var target=false; var x=0; var y=''; var kind='';
+        owner.action=function(ev) {
+            count++; target=ev.target===button; kind=ev.type; x=ev.x; y=ev.y;
+        };
+        button.onClick(3.5,'seven');
+        "#,
+    );
+    // LayerIntf.cpp:9976-9980: the target is the layer, not its window.
+    assert_eq!(env.eval_int("count"), 1);
+    assert_eq!(
+        env.eval_int("target && kind==='onClick' && x===3.5 && y==='seven'"),
+        1
+    );
+}
+
+#[test]
+fn script_override_forwards_only_when_it_calls_super() {
+    let _lock = vm_lock();
+    let env = Env::new();
+    env.run(
+        r#"
+        class Button extends Layer {
+            function Button(win,parent) { super.Layer(win,parent); }
+            function onClick(x,y) { super.onClick(x,y); }
+        }
+        var owner=new Window(); var button=new Button(owner,null); var count=0;
+        owner.action=function(ev) { if(ev.type==='onClick' && ev.target===button) count++; };
+        button.onClick(1,2);
+        var forwarded=count;
+        button.onClick=function(x,y) {};
+        button.onClick(1,2);
+        "#,
+    );
+    assert_eq!(env.eval_int("forwarded"), 1);
+    assert_eq!(env.eval_int("count"), 1);
+}
+
+#[test]
+fn event_dictionary_copies_object_and_zero_argument_events() {
+    let _lock = vm_lock();
+    let env = Env::new();
+    env.run(
+        r#"
+        var owner=new Window(); var first=new Layer(owner,null); var second=new Layer(owner,first);
+        var blurred=false; var direction=false; var paint=0; var process=false;
+        owner.action=function(ev) {
+            if(ev.type==='onFocus') { blurred=ev.blurred===second; direction=ev.direction===1; }
+            if(ev.type==='onPaint' && ev.target===first) paint++;
+            if(ev.type==='onKeyDown') process=ev.key===13 && ev.shift===0 && ev.process===1;
+        };
+        first.onFocus(second,1); first.onPaint(); first.onKeyDown(13,0,1);
+        "#,
+    );
+    assert_eq!(env.eval_int("blurred && direction && process"), 1);
+    assert_eq!(env.eval_int("paint"), 1);
+}
+
+#[test]
+fn action_callback_error_is_returned_to_the_native_caller() {
+    let _lock = vm_lock();
+    let env = Env::new();
+    env.run("var owner=new Window(); var button=new Layer(owner,null); owner.action=function(ev) { throw %[message: 'action failed']; };");
+    // tjsInterCodeExec.cpp:827-852 extracts the message from exception objects.
+    let error = env.error("button.onClick(1,2)");
+    assert!(error.contains("action failed"), "callback error: {error:?}");
+}
+
+#[test]
+fn subclass_button_click_can_close_a_modal_without_a_fabricated_result() {
+    let _lock = vm_lock();
+    let env = Rc::new(Env::new());
+    env.run(
+        r#"
+        class Button extends Layer {
+            function Button(win,parent) { super.Layer(win,parent); visible=true; hitThreshold=0; }
+            function onClick(x,y) { super.onClick(x,y); }
+        }
+        class Dialog extends Window {
+            var button; var result=false; var clicks=0;
+            function Dialog() { super.Window(); setInnerSize(160,80); button=new Button(this,null); button.setSize(160,80); }
+            function action(ev) { if(ev.type==='onClick' && ev.target===button) { clicks++; result=true; close(); } }
+        }
+        var main=new Window(); var dialog=new global.Dialog();
+        "#,
+    );
+    let weak = Rc::downgrade(&env);
+    let observed = Rc::new(Cell::new(None));
+    let captured = Rc::clone(&observed);
+    env.modal_driver(Some(Rc::new(move |id| {
+        let env = weak
+            .upgrade()
+            .ok_or_else(|| CompatError::Engine("test host expired".into()))?;
+        let mut ctx = env.compat_context();
+        let mut adapter = compat::EventAdapter::with_dispatch_budget(std::time::Duration::MAX);
+        adapter.begin_input_frame(&mut ctx);
+        adapter.dispatch_frame(
+            &mut ctx,
+            &[
+                PlatformEvent::Input(InputEvent::PointerMoved { x: 10.0, y: 10.0 }),
+                PlatformEvent::Input(InputEvent::MouseButton {
+                    button: MouseButton::Left,
+                    pressed: true,
+                }),
+                PlatformEvent::Input(InputEvent::MouseButton {
+                    button: MouseButton::Left,
+                    pressed: false,
+                }),
+            ],
+        )?;
+        adapter.end_input_frame(&mut ctx);
+        captured.set(Some(compat::modal_active(&ctx, id)));
+        if compat::modal_active(&ctx, id) {
+            return Err(CompatError::Engine(
+                "button action did not close modal".into(),
+            ));
+        }
+        Ok(())
+    })));
+    env.run("dialog.showModal(); var accepted=dialog.result; var count=dialog.clicks;");
+    assert_eq!(observed.get(), Some(false));
+    assert_eq!(env.eval_int("accepted"), 1);
+    assert_eq!(env.eval_int("count"), 1);
+}
+
+#[test]
+fn action_can_reenter_the_layer_and_invalidate_its_owner() {
+    let _lock = vm_lock();
+    let env = Env::new();
+    env.run(
+        r#"
+        var owner=new Window(); var button=new Layer(owner,null); owner.add(button);
+        var clicks=0; var paints=0;
+        owner.action=function(ev) {
+            if(ev.type==='onClick') { clicks++; button.onPaint(); invalidate owner; }
+            if(ev.type==='onPaint') paints++;
+        };
+        button.onClick(1,2);
+        "#,
+    );
+    assert_eq!(env.eval_int("clicks"), 1);
+    assert_eq!(env.eval_int("paints"), 1);
+    assert_eq!(env.eval_int("isvalid owner"), 0);
+    assert_eq!(env.eval_int("isvalid button"), 0);
+}
+
+#[test]
+fn null_focus_targets_remain_null_in_action_events() {
+    let _lock = vm_lock();
+    let env = Env::new();
+    env.run(
+        r#"
+        var owner=new Window(); var button=new Layer(owner,null);
+        var focus=0; var blur=0; var before=0;
+        owner.action=function(ev) {
+            if(ev.type==='onFocus' && ev.target===button && ev.blurred===null && ev.direction===1) focus++;
+            if(ev.type==='onBlur' && ev.target===button && ev.focused===null) blur++;
+            if(ev.type==='onBeforeFocus' && ev.target===button && ev.layer===null && ev.blurred===null && ev.direction===0) before++;
+        };
+        button.onFocus(null,1);
+        button.onBlur(null);
+        button.onBeforeFocus(null,null,0);
+        "#,
+    );
+    // LayerIntf.cpp:10209-10216,10226-10234,10412-10420 copy the null variants.
+    assert_eq!(env.eval_int("focus"), 1);
+    assert_eq!(env.eval_int("blur"), 1);
+    assert_eq!(env.eval_int("before"), 1);
+}
