+fn set_argument(
+    host: &Tjs2Engine,
+    event: tjs::Tjs2ValueId,
+    name: &str,
+    value: &Value,
+) -> Result<(), String> {
+    let retained;
+    let value = match value.ty {
+        tjs::VAL_VOID => TjsValue::Void,
+        tjs::VAL_INTEGER => TjsValue::Integer(value.integer),
+        tjs::VAL_REAL => TjsValue::Real(value.real),
+        tjs::VAL_STRING => TjsValue::String(value_as_string(value)),
+        tjs::VAL_NULL => {
+            retained = host.retain_null()?;
+            TjsValue::Retained(retained.raw_id().as_ptr() as u64)
+        }
+        _ => {
+            retained = host.retain_object_arg(value)?;
+            TjsValue::Retained(retained.raw_id().as_ptr() as u64)
+        }
+    };
+    host.set_member(event, name, &value)
+}
+
+/// Build one event and release all native state before invoking script code.
+fn dispatch_action(
+    host: &Tjs2Engine,
+    owner: &tjs::DetachedValue,
+    target: *mut c_void,
+    name: &str,
+    arguments: &[Value],
+    members: &[&str],
+) -> Result<(), String> {
+    let event = event_object(host, name, target)?;
+    for (&member, argument) in members.iter().zip(arguments) {
+        set_argument(host, event.raw_id(), member, argument)?;
+    }
+    match host.member_read(owner.raw_id(), "action")? {
+        tjs::MemberRead::Void => {}
+        tjs::MemberRead::Object(action) => {
+            host.call_detached(
+                &action,
+                &[TjsValue::Retained(event.raw_id().as_ptr() as u64)],
+            )?;
+        }
+        _ => return Err("Layer action owner has a non-callable action member".to_owned()),
+    }
+    Ok(())
+}
