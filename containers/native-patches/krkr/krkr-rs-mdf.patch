diff --git a/crates/platform/media/psd/tests/streams.rs b/crates/platform/media/psd/tests/streams.rs
new file mode 100644
index 0000000..bbe3ad8
--- /dev/null
+++ b/crates/platform/media/psd/tests/streams.rs
@@ -0,0 +1,82 @@
+//! MDF stream recognition through the public PSB parser.
+
+use std::io::Write;
+
+use flate2::Compression;
+use flate2::write::ZlibEncoder;
+use psd::container::{self, PsbValue};
+use psd::error::PsbError;
+
+/// Both spellings inflate before the PSB document is parsed
+/// (`reference/cpp/plugins/psbfile/PSBStreamDecompress.cpp:54-58`).
+#[test]
+fn mdf_spellings_parse() {
+    let payload = empty_psb();
+    for magic in [b"MDF", b"mdf"] {
+        let input = mdf_stream(magic, &payload);
+        let document = container::parse_stream(&input, 0).expect("the MDF document parses");
+        assert_eq!(document.root, PsbValue::Dictionary(Vec::new()));
+        assert!(document.resources.is_empty());
+    }
+}
+
+/// Invalid zlib data in a lowercase wrapper fails during decompression
+/// (`reference/cpp/plugins/psbfile/PSBStreamDecompress.cpp:22-25,54-58`).
+#[test]
+fn lowercase_mdf_rejects_corruption() {
+    let mut input = Vec::from(*b"mdf\0");
+    input.extend_from_slice(&1u32.to_le_bytes());
+    input.extend_from_slice(&[0; 8]);
+    assert!(matches!(
+        container::parse_stream(&input, 0),
+        Err(PsbError::Decompress(_))
+    ));
+}
+
+/// Mixed spellings pass through unchanged, so the PSB parser rejects their
+/// signature (`reference/cpp/plugins/psbfile/PSBStreamDecompress.cpp:54-66`).
+#[test]
+fn mixed_case_mdf_stays_unknown() {
+    let payload = empty_psb();
+    for magic in [b"MDf", b"MdF", b"Mdf", b"mDF", b"mDf", b"mdF"] {
+        let input = mdf_stream(magic, &payload);
+        assert!(matches!(
+            container::parse_stream(&input, 0),
+            Err(PsbError::BadSignature(signature)) if signature[..3] == magic[..]
+        ));
+    }
+}
+
+fn mdf_stream(magic: &[u8; 3], payload: &[u8]) -> Vec<u8> {
+    let mut encoder = ZlibEncoder::new(Vec::new(), Compression::default());
+    encoder.write_all(payload).expect("encode fixture");
+    let compressed = encoder.finish().expect("finish fixture");
+    let mut input = Vec::from(*magic);
+    input.push(0);
+    input.extend_from_slice(
+        &u32::try_from(payload.len())
+            .expect("fixture size")
+            .to_le_bytes(),
+    );
+    input.extend_from_slice(&compressed);
+    input
+}
+
+/// Version 2 with empty name/string/chunk tables and an empty root dictionary
+/// (`reference/cpp/plugins/psbfile/PSBHeader.h:54-85`,
+/// `reference/cpp/plugins/psbfile/PSBFile.cpp:484-526`).
+fn empty_psb() -> Vec<u8> {
+    let mut data = Vec::from(*b"PSB\0");
+    data.extend_from_slice(&2u16.to_le_bytes());
+    data.extend_from_slice(&0u16.to_le_bytes());
+    for offset in [40u32, 40, 49, 52, 52, 55, 58, 58] {
+        data.extend_from_slice(&offset.to_le_bytes());
+    }
+    // Six empty arrays: three name tables, strings, chunk offsets and lengths.
+    for _ in 0..6 {
+        data.extend_from_slice(&[0x0d, 0, 0x0d]);
+    }
+    // A dictionary with empty name-index and value-offset arrays.
+    data.extend_from_slice(&[0x21, 0x0d, 0, 0x0d, 0x0d, 0, 0x0d]);
+    data
+}
