+//! Incremental FFmpeg audio preserves PCM, timing, and sample-accurate seeks.
+#![cfg(feature = "video-ffmpeg")]
+
+use std::sync::Arc;
+
+use api::error::MediaError;
+use media::{
+    FfmpegAudioDecoderState, Media, decode_audio_ffmpeg, open_audio_ffmpeg, read_audio_ffmpeg,
+    seek_audio_ffmpeg,
+};
+use testkit::tiny_wav_mono;
+
+const OGG: &[u8] = include_bytes!("assets/sine_440hz_0.2s.ogg");
+const AAC: &[u8] = include_bytes!("assets/sine_440hz_0.5s.m4a");
+
+fn drain(state: &mut FfmpegAudioDecoderState, window: usize) -> Vec<f32> {
+    let mut result = Vec::new();
+    let mut output = vec![f32::NAN; window];
+    loop {
+        match read_audio_ffmpeg(&Media::new(), state, &mut output) {
+            Ok(0) | Err(MediaError::EndOfStream) => break,
+            Ok(count) => result.extend_from_slice(&output[..count]),
+            Err(error) => panic!("stream read failed: {error}"),
+        }
+    }
+    result
+}
+
+#[test]
+fn streaming_pcm_matches_full_decode_across_packet_boundaries() {
+    let samples: Vec<_> = (0..17003)
+        .map(|i| i16::try_from(i % 1024).unwrap() - 512)
+        .collect();
+    let wav = tiny_wav_mono(&samples, 16000);
+    for (bytes, hint, expected_frames) in [
+        (wav.as_slice(), "tone.wav", 17003),
+        (OGG, "tone.ogg", 8820),
+        (AAC, "voice.ogg", 22050),
+    ] {
+        let bytes: Arc<[u8]> = Arc::from(bytes);
+        let whole = decode_audio_ffmpeg(&Media::new(), Arc::clone(&bytes), Some(hint)).unwrap();
+        for window in [1, 17, 3001] {
+            let (spec, mut state) =
+                open_audio_ffmpeg(&Media::new(), Arc::clone(&bytes), Some(hint)).unwrap();
+            // reference/cpp/core/sound/win32/WaveImpl.cpp:2389-2463:
+            // incremental output preserves the full track's sample order.
+            assert_eq!(spec.sample_rate, whole.spec.sample_rate);
+            assert_eq!(spec.channels, whole.spec.channels);
+            // reference/cpp/core/sound/win32/WaveImpl.cpp:2389-2463:
+            // nominal duration is available before the complete PCM is decoded.
+            assert_eq!(spec.total_frames, Some(expected_frames));
+            let actual = drain(&mut state, window);
+            // reference/cpp/core/sound/win32/WaveImpl.cpp:2389-2463.
+            assert_eq!(actual, whole.interleaved, "{hint}, window={window}");
