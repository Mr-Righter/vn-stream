+fn declared_frames(
+    input: &Input,
+    index: usize,
+    rate: u32,
+    name: &str,
+) -> Result<Option<u64>, MediaError> {
+    let stream = input
+        .stream(index)
+        .ok_or_else(|| MediaError::InvalidState {
+            message: format!("{name}: audio stream vanished after probing"),
+        })?;
+    let duration = stream.duration();
+    if duration <= 0 {
+        return Ok(None);
+    }
+    let base = stream.time_base();
+    if base.numerator() <= 0 || base.denominator() <= 0 {
+        return Err(MediaError::InvalidData {
+            message: format!("{name}: audio stream time base is invalid"),
+        });
     }
+    let denominator = i128::from(base.denominator());
+    let frames = i128::from(duration)
+        .checked_mul(i128::from(base.numerator()))
+        .and_then(|value| value.checked_mul(i128::from(rate)))
+        .and_then(|value| value.checked_add(denominator / 2))
+        .ok_or_else(|| MediaError::InvalidData {
+            message: format!("{name}: audio duration overflow"),
+        })?
+        / denominator;
+    let frames = u64::try_from(frames).map_err(|_| MediaError::InvalidData {
+        message: format!("{name}: audio duration exceeds sample index range"),
+    })?;
+    Ok(Some(frames))
+}
 
