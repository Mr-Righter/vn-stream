diff --git a/crates/compat/src/natives/alpha_movie.rs b/crates/compat/src/natives/alpha_movie.rs
new file mode 100644
index 0000000..ffc5050
--- /dev/null
+++ b/crates/compat/src/natives/alpha_movie.rs
@@ -0,0 +1,691 @@
+//! Pull-driven alpha movies with independently owned decoder workers.
+#![allow(unsafe_code)]
+
+use std::ffi::{c_char, c_int, c_void};
+use std::fmt;
+
+use tjs::{NativeInstanceBuilder, NativeInstanceMethodDef, NativeInstancePropertyDef, Value};
+
+use crate::engine_api::{Rect, Scene};
+use crate::native_util::{args, report_error, set_int, set_void, value_as_string};
+use crate::natives::system::{resolve, try_value_as_i64};
+use crate::storage::strip_file_media;
+use crate::{CompatCtx, CompatError, CompatServices};
+
+mod prefetch;
+
+use prefetch::Prefetch;
+
+/// Exact stream metadata; frame rate is `fps_rate / fps_scale` frames per second.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct AlphaMovieSpec {
+    /// Number of indexed frames.
+    pub num_frames: u32,
+    /// Nominal canvas width in pixels, independent of each decoded rectangle.
+    pub screen_width: u32,
+    /// Nominal canvas height in pixels, independent of each decoded rectangle.
+    pub screen_height: u32,
+    /// Denominator of the frame rate.
+    pub fps_scale: u32,
+    /// Numerator of the frame rate.
+    pub fps_rate: u32,
+}
+
+/// A decoded rectangle with tightly packed straight RGBA pixels.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct AlphaMovieFrame {
+    /// Zero-based index within the current stream.
+    pub frame: u32,
+    /// Rectangle origin relative to the movie's script position, in pixels.
+    pub left: i32,
+    /// Rectangle origin relative to the movie's script position, in pixels.
+    pub top: i32,
+    /// Decoded rectangle width in pixels, including any encoded padding.
+    pub width: u32,
+    /// Decoded rectangle height in pixels, including any encoded padding.
+    pub height: u32,
+    /// Row-major RGBA bytes; an empty rectangle has an empty buffer.
+    pub rgba: Vec<u8>,
+}
+
+/// Failures crossing the alpha movie host boundary.
+#[derive(Debug)]
+pub enum AlphaMovieError {
+    /// No movie source is installed on this host.
+    Unavailable,
+    /// The operation needs an open session.
+    NotOpen,
+    /// A storage could not be opened or its metadata is invalid.
+    Open(String),
+    /// The host could not decode an encoded frame.
+    Decode(String),
+    /// The host could not seek an indexed frame.
+    Seek(String),
+    /// The host returned an inconsistent frame index or pixel buffer.
+    InvalidFrame(String),
+    /// A native argument could not be converted.
+    Argument(String),
+    /// The destination scene or layer is unavailable.
+    Target(String),
+}
+
+impl fmt::Display for AlphaMovieError {
+    fn fmt(&self, out: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Unavailable => out.write_str("AlphaMovie: no source installed"),
+            Self::NotOpen => out.write_str("AlphaMovie: no movie is open"),
+            Self::Open(reason) => write!(out, "can't open alpha movie file - {reason}"),
+            Self::Decode(reason) => write!(out, "AlphaMovie decode error: {reason}"),
+            Self::Seek(reason) => write!(out, "AlphaMovie seek error: {reason}"),
+            Self::InvalidFrame(reason) => write!(out, "AlphaMovie invalid frame: {reason}"),
+            Self::Argument(reason) => write!(out, "AlphaMovie: {reason}"),
+            Self::Target(reason) => write!(out, "AlphaMovie target: {reason}"),
+        }
+    }
+}
+
+impl std::error::Error for AlphaMovieError {}
+
+/// Host factory for independently owned sequential decoder sessions.
+pub trait AlphaMovieSource {
+    /// Open a VFS storage name without decoding the complete stream.
+    ///
+    /// # Errors
+    /// Returns storage, format or metadata failures without substituting a stream.
+    fn open(&mut self, path: &str) -> Result<Box<dyn AlphaMovieSession>, AlphaMovieError>;
+}
+
+/// One object's decoder cursor; the native owns prefetch and playback policy.
+pub trait AlphaMovieSession: Send {
+    /// Exact metadata for this session's stream.
+    fn spec(&self) -> AlphaMovieSpec;
+
+    /// Position the next decode at the requested zero-based frame index.
+    ///
+    /// # Errors
+    /// Returns a seek failure; the native filters indices outside the stream.
+    fn seek(&mut self, frame: u32) -> Result<(), AlphaMovieError>;
+
+    /// Decode one rectangle and advance the session cursor.
+    ///
+    /// `None` means the cursor is at end of stream. No frame clock is consulted.
+    ///
+    /// # Errors
+    /// Returns malformed data and decode failures.
+    fn next_frame(&mut self) -> Result<Option<AlphaMovieFrame>, AlphaMovieError>;
+}
+
+#[derive(Default)]
+struct AlphaMovieState {
+    source: Option<Box<dyn AlphaMovieSource>>,
+}
+
+/// Install the alpha movie source for this bound host.
+///
+/// Sessions already opened by script objects keep their independent lifetime.
+/// The source is called only on the VM thread, and the context must remain bound.
+pub fn set_alpha_movie_source(ctx: &CompatCtx, source: Box<dyn AlphaMovieSource>) {
+    // SAFETY: the caller supplies a live, bound host context.
+    unsafe { ctx.services() }.state::<AlphaMovieState>().source = Some(source);
+}
+
+struct Movie {
+    prefetch: Prefetch,
+    displayed_frame: u32,
+    left: i32,
+    top: i32,
+    preload_samples: u8,
+    playing: bool,
+}
+
+impl Default for Movie {
+    fn default() -> Self {
+        Self {
+            prefetch: Prefetch::default(),
+            displayed_frame: 0,
+            left: 0,
+            top: 0,
+            preload_samples: 5,
+            playing: true,
+        }
+    }
+}
+
+fn open_session(
+    services: &CompatServices,
+    path: &str,
+) -> Result<Box<dyn AlphaMovieSession>, AlphaMovieError> {
+    let mut state = services.state::<AlphaMovieState>();
+    let source = state.source.as_mut().ok_or(AlphaMovieError::Unavailable)?;
+    let session = source.open(strip_file_media(path))?;
+    let spec = session.spec();
+    if spec.num_frames == 0
+        || spec.screen_width == 0
+        || spec.screen_height == 0
+        || spec.fps_scale == 0
+        || spec.fps_rate == 0
+    {
+        return Err(AlphaMovieError::Open(path.into()));
+    }
+    Ok(session)
+}
+
+impl Movie {
+    fn metadata(&self) -> Result<AlphaMovieSpec, AlphaMovieError> {
+        self.prefetch.state().spec.ok_or(AlphaMovieError::NotOpen)
+    }
+
+    fn open(&mut self, services: &CompatServices, path: &str) -> Result<(), AlphaMovieError> {
+        // The VM owns the source; only its returned Send session crosses threads.
+        self.prefetch.replace(None);
+        let session = open_session(services, path)?;
+        self.prefetch.replace(Some(session));
+        Ok(())
+    }
+
+    fn service_next_file(&mut self, services: &CompatServices) {
+        let Some((generation, path)) = self.prefetch.request() else {
+            return;
+        };
+        // No queue lock or worker decoder borrow survives a host factory call.
+        match open_session(services, &path) {
+            Ok(session) => self.prefetch.supply(generation, Some(session)),
+            Err(error) => {
+                log::debug!("AlphaMovie next file {path:?} could not open: {error}");
+                self.prefetch.supply(generation, None);
+            }
+        }
+    }
+
+    fn play(&mut self, _services: &CompatServices) -> Result<(), AlphaMovieError> {
+        self.playing = false;
+        self.prefetch.play(usize::from(self.preload_samples))?;
+        self.playing = true;
+        Ok(())
+    }
+
+    fn seek(&mut self, _services: &CompatServices, frame: u32) -> Result<(), AlphaMovieError> {
+        self.prefetch.seek(frame)
+    }
+
+    fn show(
+        &mut self,
+        services: &CompatServices,
+        layer: Option<u32>,
+    ) -> Result<u32, AlphaMovieError> {
+        self.service_next_file(services);
+        let Some(sample) = self.prefetch.pop()? else {
+            return Ok(self.displayed_frame);
+        };
+        self.displayed_frame = sample.frame;
+        if let Some(layer) = layer {
+            present(services, layer, sample, self.left, self.top)?;
+        }
+        Ok(self.displayed_frame)
+    }
+}
+
+fn present(
+    services: &CompatServices,
+    layer_id: u32,
+    sample: AlphaMovieFrame,
+    left: i32,
+    top: i32,
+) -> Result<(), AlphaMovieError> {
+    let scene = services
+        .scene()
+        .ok_or_else(|| AlphaMovieError::Target("no scene attached".into()))?;
+    // SAFETY: the host keeps the scene alive and dispatch runs only on the VM thread.
+    let scene: &mut Scene = unsafe { &mut *scene };
+    let layer = scene
+        .layer_mut(layer_id)
+        .ok_or_else(|| AlphaMovieError::Target("layer is no longer alive".into()))?;
+    layer.rect = Rect::new(
+        left.wrapping_add(sample.left),
+        top.wrapping_add(sample.top),
+        sample.width,
+        sample.height,
+    );
+    if sample.width > 0 && sample.height > 0 {
+        scene.layer_size_changed(layer_id);
+        if !scene.ensure_layer_image(layer_id, sample.width, sample.height) {
+            return Err(AlphaMovieError::Target("cannot allocate image".into()));
+        }
+        let bitmap = scene
+            .layer(layer_id)
+            .and_then(|layer| layer.bitmap)
+            .ok_or_else(|| AlphaMovieError::Target("layer has no image".into()))?;
+        if !scene.replace_bitmap_image(bitmap, sample.width, sample.height, sample.rgba) {
+            return Err(AlphaMovieError::Target(
+                "layer image is no longer alive".into(),
+            ));
+        }
+        if !scene.set_layer_image_size(layer_id, sample.width, sample.height) {
+            return Err(AlphaMovieError::Target("cannot resize image".into()));
+        }
+    }
+    scene.mark_layer_image_modified(layer_id);
+    Ok(())
+}
+
+fn signed(value: &Value) -> Result<i32, AlphaMovieError> {
+    let bytes = try_value_as_i64(value)
+        .map_err(AlphaMovieError::Argument)?
+        .to_le_bytes();
+    Ok(i32::from_le_bytes([bytes[0], bytes[1], bytes[2], bytes[3]]))
+}
+
+fn unsigned(value: &Value) -> Result<u32, AlphaMovieError> {
+    let bytes = try_value_as_i64(value)
+        .map_err(AlphaMovieError::Argument)?
+        .to_le_bytes();
+    Ok(u32::from_le_bytes([bytes[0], bytes[1], bytes[2], bytes[3]]))
+}
+
+fn dispatch(
+    engine: *mut c_void,
+    instance: *mut c_void,
+    out_error: *mut *mut c_char,
+    operation: impl FnOnce(&CompatServices, &mut Movie) -> Result<(), AlphaMovieError>,
+) -> c_int {
+    let Some(binding) = resolve(engine) else {
+        return report_error(out_error, "AlphaMovie: compat context is not bound");
+    };
+    let ctx = binding.ctx();
+    // SAFETY: the binding holds the live services and the VM owns this unique payload.
+    let services = unsafe { ctx.services() };
+    // SAFETY: this native callback receives the live Movie allocated by create.
+    let movie = unsafe { &mut *instance.cast::<Movie>() };
+    match operation(services, movie) {
+        Ok(()) => 0,
+        Err(error) => report_error(out_error, &error.to_string()),
+    }
+}
+
+extern "C" fn create(_engine: *mut c_void) -> *mut c_void {
+    Box::into_raw(Box::new(Movie::default())).cast()
+}
+
+extern "C" fn destroy(_engine: *mut c_void, instance: *mut c_void) {
+    if !instance.is_null() {
+        // SAFETY: create allocated the payload and the VM destroys it exactly once.
+        drop(unsafe { Box::from_raw(instance.cast::<Movie>()) });
+    }
+}
+
+extern "C" fn invalidate(_engine: *mut c_void, instance: *mut c_void) {
+    // SAFETY: the VM supplies a live payload and does not dispatch its methods after invalidation.
+    let movie = unsafe { &mut *instance.cast::<Movie>() };
+    movie.playing = false;
+    movie.prefetch.stop();
+    movie.prefetch.clear();
+    movie.prefetch.replace(None);
+}
+
+fn construct(
+    _services: &CompatServices,
+    _movie: &mut Movie,
+    _arguments: &[Value],
+    out: *mut Value,
+) -> Result<(), AlphaMovieError> {
+    set_void(out);
+    Ok(())
+}
+
+fn open(
+    services: &CompatServices,
+    movie: &mut Movie,
+    arguments: &[Value],
+    out: *mut Value,
+) -> Result<(), AlphaMovieError> {
+    movie.open(services, &value_as_string(&arguments[0]))?;
+    set_void(out);
+    Ok(())
+}
+
+fn clear(
+    _services: &CompatServices,
+    movie: &mut Movie,
+    _arguments: &[Value],
+    out: *mut Value,
+) -> Result<(), AlphaMovieError> {
+    movie.prefetch.clear();
+    set_void(out);
+    Ok(())
+}
+
+fn play(
+    services: &CompatServices,
+    movie: &mut Movie,
+    _arguments: &[Value],
+    out: *mut Value,
+) -> Result<(), AlphaMovieError> {
+    movie.play(services)?;
+    set_void(out);
+    Ok(())
+}
+
+fn stop(
+    _services: &CompatServices,
+    movie: &mut Movie,
+    _arguments: &[Value],
+    out: *mut Value,
+) -> Result<(), AlphaMovieError> {
+    movie.playing = false;
+    movie.prefetch.stop();
+    set_void(out);
+    Ok(())
+}
+
+fn is_playing(
+    _services: &CompatServices,
+    movie: &mut Movie,
+    _arguments: &[Value],
+    out: *mut Value,
+) -> Result<(), AlphaMovieError> {
+    set_int(out, i64::from(movie.playing));
+    Ok(())
+}
+
+fn position(
+    _services: &CompatServices,
+    movie: &mut Movie,
+    arguments: &[Value],
+    out: *mut Value,
+) -> Result<(), AlphaMovieError> {
+    movie.left = signed(&arguments[0])?;
+    movie.top = signed(&arguments[1])?;
+    set_void(out);
+    Ok(())
+}
+
+fn next_file(
+    _services: &CompatServices,
+    movie: &mut Movie,
+    arguments: &[Value],
+    out: *mut Value,
+) -> Result<(), AlphaMovieError> {
+    movie.prefetch.state().next_file = value_as_string(&arguments[0]);
+    movie.prefetch.changed();
+    set_void(out);
+    Ok(())
+}
+
+extern "C" fn show(
+    engine: *mut c_void,
+    instance: *mut c_void,
+    argc: c_int,
+    argv: *const Value,
+    out: *mut Value,
+    out_error: *mut *mut c_char,
+    _objthis: *mut c_void,
+) -> c_int {
+    // SAFETY: the trampoline supplies argc live argument slots.
+    let arguments = unsafe { args(argv, argc) };
+    let Some(target) = arguments.first() else {
+        return report_error(out_error, "AlphaMovie.showNextImage: 1 argument required");
+    };
+    let Some(binding) = resolve(engine) else {
+        return report_error(out_error, "AlphaMovie: compat context is not bound");
+    };
+    let host = binding.engine();
+    let target = match host.retain_object_arg(target) {
+        Ok(target) => target,
+        Err(error) => return report_error(out_error, &error.to_string()),
+    };
+    let layer = match CompatCtx::native_instance_id(host, target.raw_id(), &["Layer"]) {
+        Ok(layer) => layer,
+        Err(error) => return report_error(out_error, &error),
+    };
+    dispatch(engine, instance, out_error, |services, movie| {
+        set_int(out, i64::from(movie.show(services, layer)?));
+        Ok(())
+    })
+}
+
+fn has_arguments(arguments: &[Value], minimum: usize) -> bool {
+    arguments.len() >= minimum
+}
+
+/// Expand a method trampoline; argument validation and error propagation remain explicit.
+macro_rules! method {
+    ($callback:ident, $minimum:literal, $operation:ident) => {
+        extern "C" fn $callback(
+            engine: *mut c_void,
+            instance: *mut c_void,
+            argc: c_int,
+            argv: *const Value,
+            out: *mut Value,
+            out_error: *mut *mut c_char,
+            _objthis: *mut c_void,
+        ) -> c_int {
+            // SAFETY: the trampoline supplies argc live argument slots.
+            let arguments = unsafe { args(argv, argc) };
+            if !has_arguments(arguments, $minimum) {
+                return report_error(
+                    out_error,
+                    concat!(
+                        "AlphaMovie.",
+                        stringify!($operation),
+                        ": insufficient arguments"
+                    ),
+                );
+            }
+            dispatch(engine, instance, out_error, |services, movie| {
+                $operation(services, movie, arguments, out)
+            })
+        }
+    };
+}
+
+method!(constructor, 0, construct);
+method!(open_movie, 1, open);
+method!(clear_movie, 0, clear);
+method!(play_movie, 0, play);
+method!(stop_movie, 0, stop);
+method!(playing, 0, is_playing);
+method!(set_position, 2, position);
+method!(set_next_file, 1, next_file);
+
+/// Expand property read trampolines over the live instance payload.
+macro_rules! read_property {
+    ($callback:ident, $read:expr) => {
+        extern "C" fn $callback(
+            engine: *mut c_void,
+            instance: *mut c_void,
+            out: *mut Value,
+            out_error: *mut *mut c_char,
+            _objthis: *mut c_void,
+        ) -> c_int {
+            dispatch(engine, instance, out_error, |_services, movie| {
+                let read: fn(&Movie) -> Result<i64, AlphaMovieError> = $read;
+                set_int(out, read(movie)?);
+                Ok(())
+            })
+        }
+    };
+}
+
+read_property!(num_frames, |movie| Ok(i64::from(
+    movie.metadata()?.num_frames
+)));
+read_property!(screen_width, |movie| Ok(i64::from(
+    movie.metadata()?.screen_width
+)));
+read_property!(screen_height, |movie| Ok(i64::from(
+    movie.metadata()?.screen_height
+)));
+read_property!(fps_scale, |movie| Ok(i64::from(
+    movie.metadata()?.fps_scale
+)));
+read_property!(fps_rate, |movie| Ok(i64::from(movie.metadata()?.fps_rate)));
+read_property!(frame, |movie| Ok(i64::from(movie.prefetch.state().frame)));
+read_property!(looping, |movie| Ok(i64::from(
+    movie.prefetch.state().looping
+)));
+read_property!(next_loop, |movie| Ok(i64::from(
+    movie.prefetch.state().next_loop
+)));
+read_property!(preload_samples, |movie| Ok(i64::from(
+    movie.preload_samples
+)));
+read_property!(left, |movie| Ok(i64::from(movie.left)));
+read_property!(top, |movie| Ok(i64::from(movie.top)));
+
+/// Expand property write trampolines over the live instance payload.
+macro_rules! write_property {
+    ($callback:ident, $write:expr) => {
+        extern "C" fn $callback(
+            engine: *mut c_void,
+            instance: *mut c_void,
+            value: *const Value,
+            out_error: *mut *mut c_char,
+            _objthis: *mut c_void,
+        ) -> c_int {
+            // SAFETY: the trampoline supplies the property's live argument slot.
+            let value = unsafe { &*value };
+            dispatch(engine, instance, out_error, |services, movie| {
+                let write: fn(&CompatServices, &mut Movie, &Value) -> Result<(), AlphaMovieError> =
+                    $write;
+                write(services, movie, value)
+            })
+        }
+    };
+}
+
+write_property!(set_frame, |services, movie, value| movie
+    .seek(services, unsigned(value)?));
+write_property!(set_looping, |_services, movie, value| {
+    movie.prefetch.state().looping = signed(value)? != 0;
+    movie.prefetch.changed();
+    Ok(())
+});
+write_property!(set_next_loop, |_services, movie, value| {
+    movie.prefetch.state().next_loop = signed(value)? != 0;
+    movie.prefetch.changed();
+    Ok(())
+});
+write_property!(set_preload_samples, |_services, movie, value| {
+    let count = signed(value)?;
+    if (1..=30).contains(&count) {
+        movie.preload_samples =
+            u8::try_from(count).map_err(|error| AlphaMovieError::Argument(error.to_string()))?;
+    }
+    Ok(())
+});
+write_property!(set_left, |_services, movie, value| {
+    movie.left = signed(value)?;
+    Ok(())
+});
+write_property!(set_top, |_services, movie, value| {
+    movie.top = signed(value)?;
+    Ok(())
+});
+
+/// Register the `AlphaMovie` native class when its plugin is linked.
+///
+/// # Errors
+/// Returns the VM's class registration failure.
+pub fn register(ctx: &mut CompatCtx) -> Result<(), CompatError> {
+    ctx.register_instance(&NativeInstanceBuilder {
+        name: "AlphaMovie",
+        create,
+        destroy,
+        invalidate: Some(invalidate),
+        methods: vec![
+            NativeInstanceMethodDef {
+                name: "AlphaMovie",
+                f: constructor,
+            },
+            NativeInstanceMethodDef {
+                name: "open",
+                f: open_movie,
+            },
+            NativeInstanceMethodDef {
+                name: "clear",
+                f: clear_movie,
+            },
