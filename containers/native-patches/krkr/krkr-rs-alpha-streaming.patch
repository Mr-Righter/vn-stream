+//! Compare incremental PCM and exact seeks with whole-track FFmpeg output.
+use std::sync::Arc;
+use std::time::Instant;
+
+use api::error::MediaError;
+use media::{Media, decode_audio_ffmpeg, open_audio_ffmpeg, read_audio_ffmpeg, seek_audio_ffmpeg};
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let media = Media::new();
+    for name in std::env::args().skip(1) {
+        let bytes: Arc<[u8]> = Arc::from(std::fs::read(&name)?);
+        let started = Instant::now();
+        let whole = decode_audio_ffmpeg(&media, Arc::clone(&bytes), Some(&name))?;
+        let whole_ms = started.elapsed().as_secs_f64() * 1000.0;
+        let started = Instant::now();
+        let (spec, mut state) = open_audio_ffmpeg(&media, bytes, Some(&name))?;
+        let open_ms = started.elapsed().as_secs_f64() * 1000.0;
+        if spec.sample_rate != whole.spec.sample_rate || spec.channels != whole.spec.channels {
+            return Err("stream format differs from whole-track output".into());
+        }
+        let channels = usize::try_from(spec.channels)?;
+        let mut output = vec![0.0; 4801 * channels];
+        let mut offset = 0;
+        loop {
+            match read_audio_ffmpeg(&media, &mut state, &mut output) {
+                Ok(0) | Err(MediaError::EndOfStream) => break,
+                Ok(count) => {
+                    if whole.interleaved.get(offset..offset + count) != Some(&output[..count]) {
+                        return Err(format!("PCM mismatch at sample {offset}").into());
+                    }
+                    offset += count;
+                }
+                Err(error) => return Err(error.into()),
+            }
+        }
+        if offset != whole.interleaved.len() {
+            return Err("PCM length mismatch".into());
+        }
+        for frame in [1, 1023, 1025, whole.frame_count() / 2] {
+            seek_audio_ffmpeg(&media, &mut state, frame)?;
+            let count = read_audio_ffmpeg(&media, &mut state, &mut output)?;
+            let offset = usize::try_from(frame)? * channels;
+            if whole.interleaved.get(offset..offset + count) != Some(&output[..count]) {
+                return Err(format!("seek mismatch at frame {frame}").into());
+            }
+        }
+        println!(
+            "{name}\t{}Hz\t{}ch\tnominal={:?}\tpcm={}\twhole_ms={whole_ms:.3}\topen_ms={open_ms:.3}\texact=true",
+            spec.sample_rate,
+            spec.channels,
+            spec.total_frames,
+            whole.interleaved.len()
+        );
+    }
+    Ok(())
+}
