+/// Copies the next frame-aligned interleaved `f32` samples into `out`.
+///
+/// Retains at most one converted codec frame between calls. A partial frame
+/// at the end of `out` is untouched. Raw PCM includes any codec end padding;
+/// callers use the opened spec's nominal length for presentation clipping.
+///
+/// # Errors
+/// Returns `EndOfStream` only when no samples remain, and preserves typed
+/// demux/codec/conversion errors. A failure after a partial read is reported on
+/// the following call so samples already copied are never discarded.
+pub fn read_audio_ffmpeg(
+    media: &Media,
+    state: &mut FfmpegAudioDecoderState,
+    out: &mut [f32],
+) -> Result<usize, MediaError> {
