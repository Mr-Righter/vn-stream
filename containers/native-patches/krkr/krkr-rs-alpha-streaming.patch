+/// Audio ownership differs between deterministic headless and live playback.
+pub(crate) enum AudioOutput {
+    Headless(Box<FrameOutput>),
+    Live(ThreadOutput),
+}
+
+impl AudioOutput {
+    pub(crate) fn open(headless: bool) -> Result<Self, PlatformError> {
+        if headless {
+            FrameOutput::open(true).map(Box::new).map(Self::Headless)
+        } else {
+            // Reject stale malformed configuration instead of silently ignoring it.
+            configured_max_chunk_ms()?;
+            ThreadOutput::open().map(Self::Live)
+        }
+    }
+
+    /// Bind the mixer before scripts open their first sound.
+    pub(crate) fn start(&mut self, vm: &VmHost) -> Result<(), GameError> {
+        if let Self::Live(output) = self {
+            let ctx = vm.compat().ctx().map_err(vm::VmError::from)?;
+            let mixer = sound_output(&ctx).map_err(vm::VmError::from)?;
+            output
+                .bind
+                .take()
+                .ok_or_else(|| audio_failure("audio output already bound"))?
+                .send(mixer)
+                .map_err(|_| audio_failure("audio output stopped before binding"))?;
+        }
+        Ok(())
+    }
+
+    pub(crate) fn max_chunk_ms(&self) -> f64 {
+        match self {
+            Self::Headless(output) => output.max_chunk_ms(),
+            // Live audio follows device consumption, so movies must not discard
+            // elapsed frame time and seek that independent audio backwards.
+            Self::Live(_) => f64::INFINITY,
+        }
+    }
+
+    pub(crate) fn pump(&mut self, vm: &VmHost, dt_ms: f64) -> Result<(), GameError> {
+        match self {
+            Self::Headless(output) => output.pump(vm, dt_ms),
+            Self::Live(output) => match output.errors.try_recv() {
+                Ok(message) => Err(audio_failure(message).into()),
+                Err(mpsc::TryRecvError::Empty) => Ok(()),
+                Err(mpsc::TryRecvError::Disconnected) => {
+                    Err(audio_failure("audio producer terminated unexpectedly").into())
+                }
+            },
+        }
+    }
+}
+
+fn audio_failure(message: impl Into<String>) -> PlatformError {
+    AudioError::Stream {
+        message: message.into(),
+    }
+    .into()
+}
+
+/// The live worker owns the platform stream, which need not implement Send.
+pub(crate) struct ThreadOutput {
+    bind: Option<mpsc::Sender<MixerOutput>>,
+    stop: Arc<AtomicBool>,
+    worker: Option<JoinHandle<()>>,
+    errors: mpsc::Receiver<String>,
+}
+
+impl ThreadOutput {
+    fn open() -> Result<Self, PlatformError> {
+        let (ready, opened) = mpsc::sync_channel(1);
+        let (bind, bound) = mpsc::channel::<MixerOutput>();
+        let (failure, errors) = mpsc::channel();
+        let stop = Arc::new(AtomicBool::new(false));
+        let stopped = Arc::clone(&stop);
+        let worker = thread::Builder::new()
+            .name("audio-output".into())
+            .spawn(move || {
+                let opened = AudioDevice::default_spec().and_then(AudioDevice::open);
+                let (device, mut state) = match opened {
+                    Ok(pair) => pair,
+                    Err(error) => {
+                        let _disconnected = ready.send(Err(error));
+                        return;
+                    }
+                };
+                let spec = device.spec();
+                if ready.send(Ok(())).is_err() {
+                    device.stop(&mut state);
+                    return;
+                }
+                // Dropping bind during failed startup releases this wait and device.
+                if let Ok(mixer) = bound.recv() {
+                    let result = produce_audio(&device, &mut state, spec, &mixer, &stopped);
+                    if let Err(error) = result {
+                        log::error!("audio output: {error}");
+                        let _disconnected = failure.send(error.to_string());
+                    }
+                }
+                device.stop(&mut state);
+            })
+            .map_err(|error| audio_failure(format!("could not start audio output: {error}")))?;
+        match opened.recv() {
+            Ok(Ok(())) => Ok(Self {
+                bind: Some(bind),
+                stop,
+                worker: Some(worker),
+                errors,
+            }),
+            result => {
+                drop(bind);
+                if worker.join().is_err() {
+                    log::error!("audio output initialization panicked");
+                }
+                match result {
+                    Ok(Err(error)) => Err(error),
+                    _ => Err(audio_failure("audio output initialization terminated")),
+                }
+            }
+        }
+    }
+}
+
+impl Drop for ThreadOutput {
+    fn drop(&mut self) {
+        self.stop.store(true, Ordering::Release);
+        // Unblock either the initial bind receive or a timed queue wait.
+        self.bind.take();
+        if let Some(worker) = self.worker.take() {
+            worker.thread().unpark();
+            if worker.join().is_err() {
+                log::error!("audio output thread panicked during shutdown");
+            }
+        }
+    }
+}
+
+/// Refill the existing 150 ms L1 reservoir in at most 10 ms chunks.
+fn produce_audio(
+    device: &AudioDevice,
+    state: &mut AudioOutputState,
+    spec: AudioSpec,
+    mixer: &MixerOutput,
+    stop: &AtomicBool,
+) -> Result<(), PlatformError> {
+    let channels =
+        usize::try_from(spec.channels).map_err(|_| audio_failure("channel count overflow"))?;
+    let chunk_frames = usize::try_from(spec.sample_rate.div_ceil(100))
+        .map_err(|_| audio_failure("sample rate overflow"))?;
+    let mut buffer = vec![
+        0.0;
+        chunk_frames
+            .checked_mul(channels)
+            .ok_or_else(|| audio_failure("audio buffer size overflow"))?
+    ];
+    let mut health_seen = AudioHealth::default();
+    while !stop.load(Ordering::Acquire) {
+        let depth = device.queued_seconds(state);
+        mixer.set_output_latency(depth);
+        let health = device.health(state);
+        let episodes = AudioEpisodes::between(&health_seen, health);
+        if episodes.underruns > 0 || episodes.overruns > 0 {
+            log::warn!(
+                "audio device: {} underrun(s), {} overrun(s), {:.0} ms queued",
+                health.underrun_episodes,
+                health.overrun_episodes,
+                depth * 1000.0
+            );
+        }
+        health_seen = health;
+        if depth < 0.150 {
+            mixer
+                .render(&mut buffer, spec)
+                .map_err(|error| audio_failure(error.to_string()))?;
+            device.write(state, &buffer)?;
+        } else {
+            thread::park_timeout(Duration::from_millis(3));
+        }
+    }
+    Ok(())
+}
