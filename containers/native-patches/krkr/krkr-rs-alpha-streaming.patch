new file mode 100644
index 0000000..f65c61b
--- /dev/null
+++ b/crates/compat/src/natives/alpha_movie/prefetch.rs
@@ -0,0 +1,613 @@
+//! Owned decoder worker. This module never borrows VM, storage or scene state.
+
+use std::collections::VecDeque;
+use std::sync::{Arc, Condvar, LockResult, Mutex, MutexGuard};
+use std::thread::{self, JoinHandle};
+
+use super::{AlphaMovieError, AlphaMovieFrame, AlphaMovieSession, AlphaMovieSpec};
+
+// Ready RGBA is bounded independently of the script's 1..=30 sample count.
+// One decoded sample may wait outside this budget; it is never silently dropped.
+// The host additionally limits each decoded frame to 64 MiB.
+const READY_BYTES: usize = 128 * 1024 * 1024;
+
+pub(super) struct State {
+    pub spec: Option<AlphaMovieSpec>,
+    pub frame: u32,
+    pub looping: bool,
+    pub next_loop: bool,
+    pub next_file: String,
+    generation: u64,
+    ready: VecDeque<AlphaMovieFrame>,
+    bytes: usize,
+    byte_limit: usize,
+    capacity: usize,
+    replacement: Option<Option<Box<dyn AlphaMovieSession>>>,
+    seek: Option<u32>,
+    replacement_is_next: bool,
+    request: Option<(u64, String)>,
+    waiting: bool,
+    ended: bool,
+    suspended: bool,
+    stop: bool,
+    error: Option<AlphaMovieError>,
+}
+
+impl Default for State {
+    fn default() -> Self {
+        Self {
+            spec: None,
+            frame: 0,
+            looping: true,
+            next_loop: true,
+            next_file: String::new(),
+            generation: 0,
+            ready: VecDeque::new(),
+            bytes: 0,
+            byte_limit: READY_BYTES,
+            capacity: 0,
+            replacement: None,
+            seek: None,
+            request: None,
+            waiting: false,
+            ended: false,
+            suspended: false,
+            stop: false,
+            error: None,
+            replacement_is_next: false,
+        }
+    }
+}
+
+#[derive(Default)]
+struct Shared {
+    state: Mutex<State>,
+    changed: Condvar,
+}
+
+// Poisoning is an observable worker failure; queue ownership remains available
+// so stop, clear and destruction can still release their resources.
+fn guarded(result: LockResult<MutexGuard<'_, State>>) -> MutexGuard<'_, State> {
+    match result {
+        Ok(state) => state,
+        Err(error) => {
+            let mut state = error.into_inner();
+            state.error.get_or_insert_with(|| {
+                AlphaMovieError::Decode("decoder queue mutex poisoned".into())
+            });
+            state.ended = true;
+            state
+        }
+    }
+}
+
+#[derive(Default)]
+pub(super) struct Prefetch {
+    shared: Arc<Shared>,
+    worker: Option<JoinHandle<Option<Box<dyn AlphaMovieSession>>>>,
+    idle: Option<Box<dyn AlphaMovieSession>>,
+}
+
+impl Prefetch {
+    pub fn state(&self) -> MutexGuard<'_, State> {
+        guarded(self.shared.state.lock())
+    }
+
+    pub fn changed(&self) {
+        self.shared.changed.notify_all();
+    }
+
+    pub fn replace(&mut self, session: Option<Box<dyn AlphaMovieSession>>) {
+        let spec = session.as_ref().map(|session| session.spec());
+        let suspended = session.is_none();
+        if self.worker.is_none() {
+            self.idle = session;
+            let mut state = self.state();
+            state.spec = spec.or(state.spec);
+            state.frame = 0;
+            state.suspended = suspended;
+        } else {
+            let mut state = self.state();
+            state.generation = state.generation.wrapping_add(1);
+            state.spec = spec.or(state.spec);
+            state.frame = 0;
+            let displaced = state.replacement.replace(session);
+            state.suspended = suspended;
+            state.replacement_is_next = false;
+            state.seek = None;
+            state.request = None;
+            state.waiting = false;
+            drop(state);
+            drop(displaced);
+        }
+        self.changed();
+    }
+
+    pub fn stop(&mut self) {
+        {
+            let mut state = self.state();
+            state.stop = true;
+            state.generation = state.generation.wrapping_add(1);
+        }
+        self.changed();
+        if let Some(worker) = self.worker.take() {
+            match worker.join() {
+                Ok(session) => self.idle = session,
+                Err(panic) => {
+                    log::error!("AlphaMovie decoder worker panicked: {panic:?}");
+                    self.state().error =
+                        Some(AlphaMovieError::Decode("decoder worker panicked".into()))
+                }
+            }
+        }
+    }
+
+    pub fn play(&mut self, capacity: usize) -> Result<(), AlphaMovieError> {
+        self.stop();
+        let session = self.idle.take().ok_or(AlphaMovieError::NotOpen)?;
+        {
+            let mut state = self.state();
+            state.ready.clear();
+            state.bytes = 0;
+            state.capacity = capacity;
+            state.frame = 0;
+            state.seek = Some(0);
+            state.stop = false;
+            state.ended = false;
+            state.suspended = false;
+            state.error = None;
+            state.request = None;
+            state.waiting = false;
+        }
+        let shared = Arc::clone(&self.shared);
+        self.worker = Some(
+            thread::Builder::new()
+                .name("alpha-movie-decode".into())
+                .spawn(move || {
+                    match std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                        run(&shared, session)
+                    })) {
+                        Ok(session) => session,
+                        Err(panic) => {
+                            log::error!("AlphaMovie decoder worker panicked: {panic:?}");
+                            let mut state = guarded(shared.state.lock());
+                            state.error =
+                                Some(AlphaMovieError::Decode("decoder worker panicked".into()));
+                            state.ended = true;
+                            shared.changed.notify_all();
+                            None
+                        }
+                    }
+                })
+                .map_err(|error| {
+                    AlphaMovieError::Decode(format!("cannot start decoder worker: {error}"))
+                })?,
+        );
+        Ok(())
+    }
+
+    pub fn clear(&self) {
+        let mut state = self.state();
+        state.generation = state.generation.wrapping_add(1);
+        state.ready.clear();
+        state.bytes = 0;
+        state.capacity = 0;
+        state.request = None;
+        state.waiting = false;
+        drop(state);
+        self.changed();
+    }
+
+    pub fn seek(&mut self, frame: u32) -> Result<(), AlphaMovieError> {
+        let valid = {
+            let mut state = self.state();
+            state.generation = state.generation.wrapping_add(1);
+            state.ready.clear();
+            state.bytes = 0;
+            state.request = None;
+            state.waiting = false;
+            let valid = frame < state.spec.ok_or(AlphaMovieError::NotOpen)?.num_frames;
+            state.suspended = !valid;
+            if valid {
+                state.frame = frame;
+                if self.worker.is_some() {
+                    state.seek = Some(frame);
+                }
+            }
+            valid
+        };
+        if valid && let Some(session) = self.idle.as_mut() {
+            session.seek(frame)?;
+        }
+        self.changed();
+        Ok(())
+    }
+
+    pub fn pop(&self) -> Result<Option<AlphaMovieFrame>, AlphaMovieError> {
+        let mut state = self.state();
+        if let Some(error) = state.error.take() {
+            return Err(error);
+        }
+        let sample = state.ready.pop_front();
+        if let Some(sample) = &sample {
+            state.bytes -= sample.rgba.len();
+        }
+        drop(state);
+        self.changed();
+        Ok(sample)
+    }
+
+    pub fn request(&self) -> Option<(u64, String)> {
+        self.state().request.take()
+    }
+
+    pub fn supply(&self, generation: u64, session: Option<Box<dyn AlphaMovieSession>>) {
+        let spec = session.as_ref().map(|session| session.spec());
+        let mut state = self.state();
+        if state.generation != generation || !state.waiting {
+            return;
+        }
+        let replacement = if let Some(session) = session {
+            state.spec = spec;
+            state.frame = 0;
+            state.looping = state.next_loop;
+            state.replacement_is_next = true;
+            Some(session)
+        } else {
+            state.ended = true;
+            None
+        };
+        let displaced = state.replacement.replace(replacement);
+        state.waiting = false;
+        drop(state);
+        drop(displaced);
+        self.changed();
+    }
+}
+
+impl Drop for Prefetch {
+    fn drop(&mut self) {
+        self.stop();
+    }
+}
+
+fn run(shared: &Shared, initial: Box<dyn AlphaMovieSession>) -> Option<Box<dyn AlphaMovieSession>> {
+    let mut session = Some(initial);
+    let mut last = 0;
+    let mut pending: Option<(u64, AlphaMovieFrame)> = None;
+    let mut first_of_next = false;
+    loop {
+        let mut state = guarded(shared.state.lock());
+        if let Some(replacement) = state.replacement.take() {
+            // Session destruction and all decoder calls happen outside the queue lock.
+            first_of_next = state.replacement_is_next;
+            drop(state);
+            session = replacement;
+            last = 0;
+            pending = None;
+            continue;
+        }
+        if state.stop {
+            return session;
+        }
+        if let Some(frame) = state.seek.take() {
+            let generation = state.generation;
+            drop(state);
+            let result = session
+                .as_mut()
+                .ok_or(AlphaMovieError::NotOpen)
+                .and_then(|session| session.seek(frame));
+            state = guarded(shared.state.lock());
+            if generation == state.generation {
+                last = frame;
+                first_of_next = false;
+                if let Err(error) = result {
+                    state.error = Some(error);
+                    state.ended = true;
+                }
+                shared.changed.notify_all();
+            }
+            pending = None;
+            continue;
+        }
+        if pending
+            .as_ref()
+            .is_some_and(|(generation, _)| *generation != state.generation)
+        {
+            pending = None;
+        }
+        if let Some((_, sample)) = pending.take_if(|(_, sample)| {
+            state.ready.len() < state.capacity
+                && state.bytes + sample.rgba.len() <= state.byte_limit
+        }) {
+            state.bytes += sample.rgba.len();
+            state.ready.push_back(sample);
+            shared.changed.notify_all();
+            continue;
+        }
+        if state.ended
+            || state.suspended
+            || state.waiting
+            || pending.is_some()
+            || state.ready.len() >= state.capacity
+            || state.bytes >= state.byte_limit
+        {
+            drop(guarded(shared.changed.wait(state)));
+            continue;
+        }
+        let Some(spec) = state.spec else {
+            state.ended = true;
+            continue;
+        };
+        let generation = state.generation;
+        let byte_limit = state.byte_limit;
+        // Frame records the last decoded index, not the session's next cursor.
+        let rewind = !first_of_next && last >= spec.num_frames - 1;
+        if rewind && !state.looping {
+            if state.next_file.is_empty() {
+                state.ended = true;
+            } else {
+                state.request = Some((generation, state.next_file.clone()));
+                state.waiting = true;
+            }
+            shared.changed.notify_all();
+            continue;
+        }
+        drop(state);
+        let result = (|| {
+            let session = session.as_mut().ok_or(AlphaMovieError::NotOpen)?;
+            if rewind {
+                session.seek(0)?;
+            }
+            let sample = session.next_frame()?.ok_or_else(|| {
+                AlphaMovieError::Decode("stream ended before its indexed final frame".into())
+            })?;
+            let bytes = u64::from(sample.width)
+                .checked_mul(u64::from(sample.height))
+                .and_then(|count| count.checked_mul(4));
+            let actual = u64::try_from(sample.rgba.len())
+                .map_err(|error| AlphaMovieError::InvalidFrame(error.to_string()))?;
+            if bytes != Some(actual) || sample.frame >= spec.num_frames {
+                return Err(AlphaMovieError::InvalidFrame(
+                    "rectangle or index does not match the stream".into(),
+                ));
+            }
+            if sample.rgba.len() > byte_limit {
+                return Err(AlphaMovieError::InvalidFrame(
+                    "decoded RGBA frame exceeds the 128 MiB prefetch budget".into(),
+                ));
+            }
+            Ok(sample)
+        })();
+        first_of_next = false;
+        let mut state = guarded(shared.state.lock());
+        if generation != state.generation {
+            continue;
+        }
+        match result {
+            Ok(sample) => {
+                last = sample.frame;
+                state.frame = sample.frame;
+                pending = Some((generation, sample));
+            }
+            Err(error) => {
+                state.error = Some(error);
+                state.ended = true;
+            }
+        }
+        shared.changed.notify_all();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    use std::time::{Duration, Instant};
+
+    use super::*;
+
+    struct Session {
+        count: u32,
+        cursor: u32,
+        decoded: Arc<AtomicUsize>,
+    }
+
+    impl AlphaMovieSession for Session {
+        fn spec(&self) -> AlphaMovieSpec {
+            AlphaMovieSpec {
+                num_frames: self.count,
+                screen_width: 1,
+                screen_height: 1,
+                fps_scale: 1,
+                fps_rate: 30,
+            }
+        }
+        fn seek(&mut self, frame: u32) -> Result<(), AlphaMovieError> {
+            self.cursor = frame;
+            Ok(())
+        }
+        fn next_frame(&mut self) -> Result<Option<AlphaMovieFrame>, AlphaMovieError> {
+            if self.cursor >= self.count {
+                return Ok(None);
+            }
+            let frame = self.cursor;
+            self.cursor += 1;
+            self.decoded.fetch_add(1, Ordering::SeqCst);
+            Ok(Some(AlphaMovieFrame {
+                frame,
+                left: 0,
+                top: 0,
+                width: 1,
+                height: 1,
+                rgba: vec![1, 2, 3, 4],
+            }))
+        }
+    }
+
+    fn session(count: u32, decoded: &Arc<AtomicUsize>) -> Box<dyn AlphaMovieSession> {
+        Box::new(Session {
+            count,
+            cursor: 0,
+            decoded: Arc::clone(decoded),
+        })
+    }
+
+    fn await_state(prefetch: &Prefetch, predicate: impl Fn(&State) -> bool) {
+        let deadline = Instant::now() + Duration::from_secs(5);
+        let mut state = prefetch.state();
+        while !predicate(&state) {
+            let remaining = deadline
+                .checked_duration_since(Instant::now())
+                .expect("worker progress timed out");
+            state = prefetch
+                .shared
+                .changed
+                .wait_timeout(state, remaining)
+                .expect("worker state")
+                .0;
+        }
+    }
+
+    #[test]
+    fn acknowledged_eof_seek_and_open_need_play_to_restart() {
+        let decoded = Arc::new(AtomicUsize::new(0));
+        let mut prefetch = Prefetch::default();
+        prefetch.replace(Some(session(3, &decoded)));
+        prefetch.state().looping = false;
+        prefetch.play(1).expect("play");
+        for frame in 0..3 {
+            await_state(&prefetch, |state| {
+                state
+                    .ready
+                    .front()
+                    .is_some_and(|sample| sample.frame == frame)
+            });
+            // reference/cpp/plugins/AlphaMovie.cpp:1154-1170,1182-1198,1229-1277
+            assert_eq!(prefetch.pop().expect("decode").expect("ready").frame, frame);
+        }
+        await_state(&prefetch, |state| state.ended);
+        prefetch.seek(1).expect("seek after EOF");
+        await_state(&prefetch, |state| state.seek.is_none());
+        // reference/cpp/plugins/AlphaMovie.cpp:1154-1170,1182-1198,1229-1277
+        assert_eq!(prefetch.state().frame, 1);
+        // reference/cpp/plugins/AlphaMovie.cpp:1154-1170,1182-1198,1229-1277
+        assert!(prefetch.pop().expect("no decode error").is_none());
+        // reference/cpp/plugins/AlphaMovie.cpp:1154-1170,1182-1198,1229-1277
+        assert_eq!(decoded.load(Ordering::SeqCst), 3);
+        prefetch.replace(Some(session(8, &decoded)));
+        prefetch.seek(3).expect("seek new stream");
+        await_state(&prefetch, |state| {
+            state.replacement.is_none() && state.seek.is_none()
+        });
+        // reference/cpp/plugins/AlphaMovie.cpp:1154-1170,1182-1198,1229-1277
+        assert_eq!(prefetch.state().frame, 3);
+        // reference/cpp/plugins/AlphaMovie.cpp:1154-1170,1182-1198,1229-1277
+        assert_eq!(decoded.load(Ordering::SeqCst), 3);
+        prefetch.play(1).expect("replay");
+        await_state(&prefetch, |state| !state.ready.is_empty());
+        // reference/cpp/plugins/AlphaMovie.cpp:1154-1170,1182-1198,1229-1277
+        assert_eq!(prefetch.pop().expect("decode").expect("ready").frame, 0);
+    }
+
+    #[test]
+    fn final_frame_seek_and_single_frame_follow_last_decoded_eof_rule() {
+        let decoded = Arc::new(AtomicUsize::new(0));
+        let mut prefetch = Prefetch::default();
+        prefetch.replace(Some(session(1, &decoded)));
+        prefetch.state().looping = false;
