+//! Pull-driven AlphaMovie compatibility contracts.
+
+mod common;
+
+use std::sync::{Arc, Condvar, Mutex, mpsc};
+use std::time::{Duration, Instant};
+
+use common::vm_lock;
+use compat::{
+    AlphaMovieError, AlphaMovieFrame, AlphaMovieSession, AlphaMovieSource, AlphaMovieSpec,
+    CompatHost, set_alpha_movie_source,
+};
+use engine::Scene;
+use tjs::{Tjs2Engine, TjsValue};
+
+#[derive(Default)]
+struct DecodeGate {
+    state: Mutex<(bool, bool)>,
+    changed: Condvar,
+}
+
+impl DecodeGate {
+    fn wait(&self) {
+        let mut state = self.state.lock().expect("gate");
+        state.0 = true;
+        self.changed.notify_all();
+        while !state.1 {
+            let (next, timeout) = self
+                .changed
+                .wait_timeout(state, Duration::from_secs(5))
+                .expect("gate");
+            state = next;
+            assert!(!timeout.timed_out(), "decoder gate must be released");
+        }
+    }
+
+    fn release_after_return(&self, returned: mpsc::Receiver<()>) -> bool {
+        let mut state = self.state.lock().expect("gate");
+        while !state.0 {
+            let (next, timeout) = self
+                .changed
+                .wait_timeout(state, Duration::from_secs(5))
+                .expect("gate");
+            state = next;
+            assert!(!timeout.timed_out(), "decoder must start");
+        }
+        drop(state);
+        let responsive = returned.recv_timeout(Duration::from_millis(500)).is_ok();
+        let mut state = self.state.lock().expect("gate");
+        state.1 = true;
+        self.changed.notify_all();
+        responsive
+    }
+}
+
+#[derive(Default)]
+struct Trace {
+    opened: Vec<String>,
+    decoded: usize,
+    dropped: usize,
+    gate: Option<Arc<DecodeGate>>,
+}
+
+struct Source(Arc<Mutex<Trace>>);
+
+impl AlphaMovieSource for Source {
+    fn open(&mut self, path: &str) -> Result<Box<dyn AlphaMovieSession>, AlphaMovieError> {
+        if path == "missing.amv" {
+            return Err(AlphaMovieError::Open("missing fixture".into()));
+        }
+        self.0.lock().expect("trace").opened.push(path.into());
+        Ok(Box::new(Session {
+            trace: self.0.clone(),
+            cursor: 0,
+            count: if path == "short.amv" { 3 } else { 8 },
+            fails: path == "broken.amv",
+            empty_start: path == "empty.amv",
+            gate: self.0.lock().expect("trace").gate.clone(),
+        }))
+    }
+}
+
+struct Session {
+    trace: Arc<Mutex<Trace>>,
+    cursor: u32,
+    count: u32,
+    fails: bool,
+    empty_start: bool,
+    gate: Option<Arc<DecodeGate>>,
+}
+
+impl AlphaMovieSession for Session {
+    fn spec(&self) -> AlphaMovieSpec {
+        AlphaMovieSpec {
+            num_frames: self.count,
+            screen_width: 630,
+            screen_height: 746,
+            fps_scale: 1001,
+            fps_rate: 30000,
+        }
+    }
+
+    fn seek(&mut self, frame: u32) -> Result<(), AlphaMovieError> {
+        self.cursor = frame;
+        Ok(())
+    }
+
+    fn next_frame(&mut self) -> Result<Option<AlphaMovieFrame>, AlphaMovieError> {
+        if self.cursor == 0
+            && let Some(gate) = &self.gate
+        {
+            gate.wait();
+        }
+        if self.fails {
+            return Err(AlphaMovieError::Decode("broken entropy".into()));
+        }
+        if self.cursor == self.count {
+            return Ok(None);
+        }
+        let frame = self.cursor;
+        self.cursor += 1;
+        self.trace.lock().expect("trace").decoded += 1;
+        if self.empty_start && frame == 0 {
+            return Ok(Some(AlphaMovieFrame {
+                frame,
+                left: 9,
+                top: 11,
+                width: 0,
+                height: 0,
+                rgba: Vec::new(),
+            }));
+        }
+        Ok(Some(AlphaMovieFrame {
+            frame,
+            left: 3,
+            top: 7,
+            width: 2,
+            height: 1,
+            rgba: if frame.is_multiple_of(2) {
+                vec![220, 10, 20, 128, 220, 10, 20, 128]
+            } else {
+                vec![0, 0, 0, 0, 10, 210, 20, 64]
+            },
+        }))
+    }
+}
+
+impl Drop for Session {
+    fn drop(&mut self) {
+        self.trace.lock().expect("trace").dropped += 1;
+    }
+}
+
+struct Env {
+    _host: CompatHost,
+    engine: Box<Tjs2Engine>,
+    scene: Box<Scene>,
+    trace: Arc<Mutex<Trace>>,
+}
+
+impl Env {
+    fn new(link: bool) -> Self {
+        let engine = Box::new(Tjs2Engine::new().expect("create VM"));
+        let mut scene = Box::<Scene>::default();
+        let mut host = CompatHost::new();
+        // SAFETY: the boxed scene outlives the host and is only used on this thread.
+        unsafe {
+            host.services_mut()
+                .attach_scene(scene.as_mut() as *mut Scene)
+        };
+        host.install(&engine).expect("install compat");
+        let trace = Arc::new(Mutex::new(Trace::default()));
+        set_alpha_movie_source(
+            &host.ctx().expect("bound host"),
+            Box::new(Source(trace.clone())),
+        );
+        let env = Self {
+            _host: host,
+            engine,
+            scene,
+            trace,
+        };
+        if link {
+            env.run("Plugins.link('AlphaMovie.dll');");
+        }
+        env
+    }
+
+    fn run(&self, script: &str) {
+        self.engine
+            .exec_script_discard(script, "alpha-movie-test")
+            .expect(script);
+    }
+
+    fn int(&self, expression: &str) -> i64 {
+        match self
+            .engine
+            .eval(expression, "alpha-movie-test")
+            .expect(expression)
+        {
+            TjsValue::Integer(value) => value,
+            value => panic!("{expression}: expected Integer, found {value:?}"),
+        }
+    }
+
+    fn until(&self, mut ready: impl FnMut() -> bool) {
+        let deadline = Instant::now() + Duration::from_secs(5);
+        while !ready() {
+            assert!(
+                Instant::now() < deadline,
+                "asynchronous movie progress timed out"
+            );
+            std::thread::yield_now();
+        }
+    }
+
+    fn decoded(&self, count: usize) {
+        self.until(|| self.trace.lock().expect("trace").decoded >= count);
+    }
+
+    fn present(&self, movie: &str, variable: &str, expected: i64) {
+        self.run("layer.left = -2147483648;");
+        self.until(|| {
+            self.run(&format!("var {variable}={movie}.showNextImage(layer);"));
+            self.int("layer.left != -2147483648") != 0
+        });
+        assert_eq!(self.int(variable), expected);
+    }
+
+    fn fails(&self, script: &str) -> bool {
+        self.engine
+            .exec_script_discard(script, "alpha-movie-test")
+            .is_err()
+    }
+}
