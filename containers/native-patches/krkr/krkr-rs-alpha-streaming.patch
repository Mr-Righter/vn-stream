+        let metadata = self.movie.metadata();
+        AlphaMovieSpec {
+            num_frames: metadata.num_frames,
+            screen_width: u32::from(metadata.width),
+            screen_height: u32::from(metadata.height),
+            fps_scale: metadata.fps_scale,
+            fps_rate: metadata.fps_rate,
+        }
+    }
+
+    fn seek(&mut self, frame: u32) -> Result<(), AlphaMovieError> {
+        if frame >= self.movie.metadata().num_frames {
+            return Err(AlphaMovieError::Seek(format!(
+                "frame {frame} is outside the stream"
+            )));
+        }
+        self.cursor = frame;
+        Ok(())
+    }
+
+    fn next_frame(&mut self) -> Result<Option<AlphaMovieFrame>, AlphaMovieError> {
+        if self.cursor == self.movie.metadata().num_frames {
+            return Ok(None);
+        }
+        let frame = self
+            .movie
+            .decode(self.cursor)
+            .map_err(|error| AlphaMovieError::Decode(error.to_string()))?;
+        self.cursor += 1;
+        Ok(Some(AlphaMovieFrame {
+            frame: frame.index,
+            left: i32::from(frame.left),
+            top: i32::from(frame.top),
+            width: u32::from(frame.width),
+            height: u32::from(frame.height),
+            rgba: frame.rgba,
+        }))
+    }
+}
