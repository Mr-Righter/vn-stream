+/// The mixer shared by native controls and an independent audio producer.
+///
+/// This handle retains only engine audio state. It carries no VM context,
+/// script values, decoder callbacks or object registry, and may be cloned
+/// into a producer thread. The producer must stop before host shutdown.
+#[derive(Clone)]
+pub struct MixerOutput {
+    mixer: Arc<Mutex<Mixer>>,
+}
+
+fn lock_mixer(mixer: &Mutex<Mixer>) -> MutexGuard<'_, Mixer> {
+    match mixer.lock() {
+        Ok(mixer) => mixer,
+        Err(poisoned) => {
+            log::error!("audio: recovering a poisoned mixer lock");
+            poisoned.into_inner()
+        }
+    }
+}
+
+impl MixerOutput {
+    /// Render interleaved samples and advance by their duration.
+    ///
+    /// This is the audio producer's sole playback clock. Calling it does not
+    /// borrow the VM's dispatch state or invoke script callbacks.
+    ///
+    /// # Errors
+    ///
+    /// Returns [`CompatError::Engine`] for an invalid output specification,
+    /// a partial output frame, or a source decoding failure.
+    pub fn render(&self, out: &mut [f32], spec: AudioSpec) -> Result<(), CompatError> {
+        validate_output(out, spec)?;
+        lock_mixer(&self.mixer)
+            .mix_advancing(out, spec)
+            .map_err(|error| CompatError::Engine(format!("sound_render: {error}")))
+    }
+
+    /// Set the current device queue latency, in seconds.
+    pub fn set_output_latency(&self, seconds: f64) {
+        lock_mixer(&self.mixer).set_output_latency(seconds);
+    }
+}
