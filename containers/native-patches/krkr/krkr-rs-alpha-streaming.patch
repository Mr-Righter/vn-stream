+        await_state(&prefetch, |state| state.ended);
+        // reference/cpp/plugins/AlphaMovie.cpp:1154-1170,1182-1198,1229-1277
+        assert_eq!(decoded.load(Ordering::SeqCst), 0);
+        // reference/cpp/plugins/AlphaMovie.cpp:1154-1170,1182-1198,1229-1277
+        assert!(prefetch.pop().expect("no decode error").is_none());
+        prefetch.replace(Some(session(8, &decoded)));
+        prefetch.state().looping = true;
+        prefetch.play(1).expect("play");
+        prefetch.seek(7).expect("seek final");
+        await_state(&prefetch, |state| !state.ready.is_empty());
+        // reference/cpp/plugins/AlphaMovie.cpp:1154-1170,1182-1198,1229-1277
+        assert_eq!(prefetch.pop().expect("decode").expect("ready").frame, 0);
+    }
+    #[test]
+    fn aggregate_rgba_budget_backpressures_without_dropping_frames() {
+        let decoded = Arc::new(AtomicUsize::new(0));
+        let mut prefetch = Prefetch::default();
+        prefetch.replace(Some(session(8, &decoded)));
+        {
+            let mut state = prefetch.state();
+            state.looping = false;
+            // Exercise the production byte-budget path with small RGBA fixtures.
+            // One ready 4-byte frame plus one pending frame fills this budget.
+            state.byte_limit = 6;
+        }
+        prefetch.play(30).expect("play");
+        await_state(&prefetch, |state| state.frame == 1);
+        // reference/cpp/plugins/AlphaMovie.cpp:1154-1170,1182-1198,1229-1277
+        assert_eq!(decoded.load(Ordering::SeqCst), 2);
+        // reference/cpp/plugins/AlphaMovie.cpp:1154-1170,1182-1198,1229-1277
+        assert_eq!(prefetch.state().bytes, 4);
+        for frame in 0..8 {
+            await_state(&prefetch, |state| {
+                state
+                    .ready
+                    .front()
+                    .is_some_and(|sample| sample.frame == frame)
+            });
+            // reference/cpp/plugins/AlphaMovie.cpp:1154-1170,1182-1198,1229-1277
+            assert_eq!(prefetch.pop().expect("decode").expect("ready").frame, frame);
+        }
+        await_state(&prefetch, |state| state.ended);
+        // reference/cpp/plugins/AlphaMovie.cpp:1154-1170,1182-1198,1229-1277
+        assert_eq!(decoded.load(Ordering::SeqCst), 8);
+    }
+
+    #[test]
+    fn seek_generation_discards_a_blocked_old_decode() {
+        struct Gated {
+            session: Session,
+            entered: std::sync::mpsc::Sender<()>,
+            release: std::sync::mpsc::Receiver<()>,
+        }
+        impl AlphaMovieSession for Gated {
+            fn spec(&self) -> AlphaMovieSpec {
+                self.session.spec()
+            }
+            fn seek(&mut self, frame: u32) -> Result<(), AlphaMovieError> {
+                self.session.seek(frame)
+            }
+            fn next_frame(&mut self) -> Result<Option<AlphaMovieFrame>, AlphaMovieError> {
+                if self.session.cursor == 0 {
+                    self.entered.send(()).expect("gate entered");
+                    self.release
+                        .recv_timeout(Duration::from_secs(5))
+                        .expect("release decoder");
+                }
+                self.session.next_frame()
+            }
+        }
+        let (entered, waiting) = std::sync::mpsc::channel();
+        let (release, released) = std::sync::mpsc::channel();
+        let mut prefetch = Prefetch::default();
+        prefetch.replace(Some(Box::new(Gated {
+            session: Session {
+                count: 8,
+                cursor: 0,
+                decoded: Arc::new(AtomicUsize::new(0)),
+            },
+            entered,
+            release: released,
+        })));
+        prefetch.play(1).expect("play");
+        waiting
+            .recv_timeout(Duration::from_secs(5))
+            .expect("decode started");
+        prefetch.seek(3).expect("seek does not wait for decoder");
+        // reference/cpp/plugins/AlphaMovie.cpp:1154-1170,1182-1198,1229-1277
+        assert!(prefetch.pop().expect("no stale frame").is_none());
+        release.send(()).expect("release old generation");
+        await_state(&prefetch, |state| !state.ready.is_empty());
