+    channels: 1,
+    total_frames: Some(1_000),
+};
+
+#[test]
+fn output_renders_while_a_decoder_borrows_vm_sound_state() {
+    let _lock = common::vm_lock();
+    let fs = FileSystem::memory();
+    for name in ["tone.wav", "blocked.wav"] {
+        let file = fs::open(&fs, &FsPath::host(name), OpenMode::Write).expect("open fixture");
+        fs::write_at(&fs, &file, 0, b"RIFF").expect("write fixture");
+        fs::flush(&fs, &file).expect("flush fixture");
+    }
+    let mut storage = Box::new(
+        Storage::mount_archives(fs, "/", std::iter::empty::<&str>()).expect("mount fixtures"),
+    );
+    let engine = Tjs2Engine::new().expect("create VM");
+    let mut host = CompatHost::new();
+    // SAFETY: storage is boxed and remains alive until after host and VM drop.
+    unsafe { host.services_mut().attach_storage(storage.as_mut()) };
+    host.install(&engine).expect("install native classes");
+    common::link_all_builtins(&engine);
+    set_sound_render_driven(host.services(), true);
+
+    let output = sound_output(&host.ctx().expect("bound context")).expect("audio output");
+    let (start, started) = mpsc::channel();
+    let (complete, completed) = mpsc::channel();
+    add_audio_decoder(
+        host.services(),
+        Box::new(move |_, loops, hint| {
+            if hint == Some("blocked.wav") {
+                start.send(()).expect("wake renderer");
+                completed
+                    .recv_timeout(Duration::from_secs(5))
+                    .expect("rendering must not wait for the decoder's VM state borrow");
+            }
+            SoundSource::with_loops(Arc::new(DecodedAudio::new(SPEC, vec![0.25; 1_000])), loops)
+                .map(Arc::new)
+                .map_err(|error| error.to_string())
+        }),
+    );
+    engine
+        .exec_script(
+            "var s = new WaveSoundBuffer(); s.open('tone.wav'); s.play();",
+            "audio-worker",
+        )
+        .expect("start source");
+
+    let worker_output = output.clone();
+    let worker = std::thread::spawn(move || {
+        started.recv().expect("decoder starts");
+        let mut pcm = [0.0; 500];
+        for chunk in pcm.as_chunks_mut::<10>().0 {
+            worker_output.render(chunk, SPEC)?;
+        }
+        complete.send(()).expect("release decoder");
+        Ok::<_, compat::CompatError>(pcm)
+    });
+    engine
+        .exec_script(
+            "var other = new WaveSoundBuffer(); other.open('blocked.wav');",
+            "audio-worker",
+        )
+        .expect("decode another source while audio renders");
+    let pcm = worker.join().expect("join renderer").expect("render audio");
+    // reference/cpp/core/sound/win32/WaveImpl.cpp:1580-1628
+    assert!(
+        pcm.iter()
+            .all(|sample| (*sample - 0.25).abs() < f32::EPSILON)
+    );
+    // reference/cpp/core/sound/win32/WaveImpl.cpp:3097-3153
+    assert!(matches!(
+        engine
+            .eval("s.samplePosition", "audio-worker")
+            .expect("position"),
+        TjsValue::Integer(500)
+    ));
+
+    let mut next = [0.0; 100];
+    output.render(&mut next, SPEC).expect("render next chunk");
+    // reference/cpp/core/sound/win32/WaveImpl.cpp:1580-1628
+    assert!(
+        next.iter()
+            .all(|sample| (*sample - 0.25).abs() < f32::EPSILON)
+    );
+    // reference/cpp/core/sound/win32/WaveImpl.cpp:3097-3153
+    assert!(matches!(
+        engine
+            .eval("s.samplePosition", "audio-worker")
+            .expect("position"),
+        TjsValue::Integer(600)
+    ));
+}
