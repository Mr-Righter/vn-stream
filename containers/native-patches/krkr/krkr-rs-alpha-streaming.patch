+//! Playback crossings survive delayed event polling, including loop passes.
+
+use std::sync::Arc;
+
+use api::media::{AudioSpec, DecodedAudio};
+use engine::sound::{
+    LoopCondition, LoopInfo, LoopLink, Mixer, SoundBuffer, SoundEvent, SoundLabel, SoundSource,
+    Status,
+};
+
+const SPEC: AudioSpec = AudioSpec {
+    sample_rate: 1_000,
+    channels: 1,
+    total_frames: Some(200),
+};
+
+fn setup(info: LoopInfo, looping: bool) -> (Mixer, SoundBuffer, u64) {
+    let source = Arc::new(
+        SoundSource::with_loops(
+            Arc::new(DecodedAudio::new(SPEC, vec![0.25; 200])),
+            Some(info),
+        )
+        .expect("source"),
+    );
+    let mut mixer = Mixer::new();
+    let id = mixer.spawn_channel();
+    let mut buffer = SoundBuffer::new();
+    buffer.open(source);
+    let channel = mixer.channel(id).expect("channel");
+    buffer.play_on(channel).expect("play");
+    channel.looping = looping;
+    buffer.poll(channel);
+    (mixer, buffer, id)
+}
+
+fn labels(events: impl IntoIterator<Item = SoundEvent>) -> Vec<String> {
+    events
+        .into_iter()
+        .filter_map(|event| match event {
+            SoundEvent::Label(name) => Some(name),
+            SoundEvent::StatusChanged(_) | SoundEvent::FadeCompleted => None,
+        })
+        .collect()
+}
+
+fn link(from: u64, to: u64, condition: LoopCondition) -> LoopLink {
+    LoopLink::new(from, to, false, condition, 1, 0)
+}
+
+#[test]
+fn rendered_loop_labels_survive_a_delayed_poll_without_duplicates() {
+    let info = LoopInfo::new(
+        vec![link(100, 0, LoopCondition::None)],
+        vec![SoundLabel::new(50, "beat".into())],
+    );
+    let (mut mixer, mut buffer, id) = setup(info, true);
+    for _ in 0..50 {
+        mixer.mix_advancing(&mut [0.0; 10], SPEC).expect("render");
+    }
+    // reference/cpp/core/sound/WaveLoopManager.cpp:434-450
+    // reference/cpp/core/sound/win32/WaveImpl.cpp:2738-2753
+    assert_eq!(
+        labels(buffer.poll(mixer.channel(id).unwrap())),
+        vec!["beat"; 5]
+    );
+    for _ in 0..10 {
+        mixer.mix_advancing(&mut [0.0; 10], SPEC).expect("render");
+    }
+    // reference/cpp/core/sound/win32/WaveImpl.cpp:2809-2850
+    assert_eq!(labels(buffer.poll(mixer.channel(id).unwrap())), ["beat"]);
+    // reference/cpp/core/sound/win32/WaveImpl.cpp:2836-2844
+    assert!(labels(buffer.poll(mixer.channel(id).unwrap())).is_empty());
+}
+
+#[test]
+fn detached_label_history_does_not_borrow_the_channel_or_buffer() {
+    let info = LoopInfo::new(
+        vec![link(100, 0, LoopCondition::None)],
+        vec![SoundLabel::new(50, "beat".into())],
+    );
+    let (mut mixer, mut buffer, id) = setup(info, true);
+    mixer.advance(3_600.0);
+    let events = buffer.events(mixer.channel(id).unwrap());
+    drop(mixer);
+    drop(buffer);
+    // reference/cpp/core/sound/win32/WaveImpl.cpp:2738-2753
+    // reference/cpp/core/sound/win32/WaveImpl.cpp:2809-2850
+    assert_eq!(labels(events.take(3)), ["beat", "beat", "beat"]);
+}
+
+#[test]
+fn equal_sample_labels_keep_order_across_loop_passes() {
+    let info = LoopInfo::new(
+        vec![link(100, 0, LoopCondition::None)],
+        vec![
+            SoundLabel::new(50, "first".into()),
+            SoundLabel::new(50, "second".into()),
+        ],
+    );
+    let (mut mixer, mut buffer, id) = setup(info, true);
+    mixer.advance(0.5);
+    // reference/cpp/core/sound/WaveLoopManager.cpp:434-450
+    // reference/cpp/core/sound/win32/WaveImpl.cpp:2738-2753
+    assert_eq!(
+        labels(buffer.poll(mixer.channel(id).unwrap())),
+        ["first", "second"].repeat(5)
+    );
+}
+
+#[test]
+fn conditional_loop_crossings_use_the_flags_at_each_advance() {
+    let info = LoopInfo::new(
+        vec![link(100, 20, LoopCondition::Equal)],
+        vec![
+            SoundLabel::new(10, "intro".into()),
+            SoundLabel::new(50, "loop".into()),
+            SoundLabel::new(150, "tail".into()),
+        ],
+    );
+    let (mut mixer, mut buffer, id) = setup(info, true);
+    mixer.channel(id).unwrap().flags_mut().set(0, 1);
+    mixer.advance(0.35);
+    mixer.channel(id).unwrap().flags_mut().set(0, 0);
+    mixer.advance(0.15);
+    // reference/cpp/core/sound/WaveLoopManager.cpp:308-322
+    // reference/cpp/core/sound/WaveLoopManager.cpp:434-450
+    assert_eq!(
+        labels(buffer.poll(mixer.channel(id).unwrap())),
+        ["intro", "loop", "loop", "loop", "loop", "loop", "tail"]
+    );
+}
+
+#[test]
+fn seek_discards_pending_crossings_and_does_not_emit_skipped_labels() {
+    let info = LoopInfo::new(Vec::new(), vec![SoundLabel::new(50, "beat".into())]);
+    let (mut mixer, mut buffer, id) = setup(info, false);
+    mixer.advance(0.07);
+    mixer.channel(id).unwrap().set_position(0.02);
+    // reference/cpp/core/sound/win32/WaveImpl.cpp:3128-3143
+    assert!(labels(buffer.poll(mixer.channel(id).unwrap())).is_empty());
+    mixer.advance(0.04);
+    // reference/cpp/core/sound/WaveLoopManager.cpp:434-450
+    assert_eq!(labels(buffer.poll(mixer.channel(id).unwrap())), ["beat"]);
+    mixer.channel(id).unwrap().set_position(0.15);
+    // reference/cpp/core/sound/win32/WaveImpl.cpp:3128-3143
+    assert!(labels(buffer.poll(mixer.channel(id).unwrap())).is_empty());
+}
+
+#[test]
+fn natural_completion_preserves_labels_crossed_before_the_end() {
+    let info = LoopInfo::new(Vec::new(), vec![SoundLabel::new(150, "tail".into())]);
+    let (mut mixer, mut buffer, id) = setup(info, false);
+    mixer.advance(0.3);
+    let events = buffer.poll(mixer.channel(id).unwrap());
+    // reference/cpp/core/sound/win32/WaveImpl.cpp:2809-2850
+    assert_eq!(labels(events.clone()), ["tail"]);
+    // reference/cpp/core/sound/win32/WaveImpl.cpp:2658-2662
+    assert!(events.contains(&SoundEvent::StatusChanged(Status::Stop)));
+}
+
+#[test]
+fn paused_audio_preserves_crossings_and_stopped_audio_cancels_them() {
+    let info = LoopInfo::new(Vec::new(), vec![SoundLabel::new(50, "beat".into())]);
+    let (mut mixer, mut buffer, id) = setup(info, false);
+    mixer.advance(0.06);
+    mixer.channel(id).unwrap().pause();
+    // reference/cpp/core/sound/win32/WaveImpl.cpp:2809-2850
+    assert_eq!(labels(buffer.poll(mixer.channel(id).unwrap())), ["beat"]);
+    mixer.channel(id).unwrap().resume();
+    mixer.channel(id).unwrap().set_position(0.0);
+    mixer.advance(0.06);
+    mixer.channel(id).unwrap().stop();
+    // reference/cpp/core/sound/win32/WaveImpl.cpp:2983-2994
+    assert!(labels(buffer.poll(mixer.channel(id).unwrap())).is_empty());
+}
