+///
+/// The host enables render-driven sound before starting the producer and
+/// keeps the producer joined before shutting down the compatibility host.
+///
+/// # Errors
+///
+/// Acquiring the handle from a live bound context is infallible.
+pub fn sound_output(ctx: &CompatCtx) -> Result<MixerOutput, CompatError> {
+    // SAFETY: a `CompatCtx` is only created for a bound, live engine.
+    let services = unsafe { ctx.services() };
+    let mixer = Arc::clone(&services.state::<SoundState>().mixer);
+    Ok(MixerOutput { mixer })
+}
