# Self-authored compatibility probe; all assets are generated by Ren'Py.
define config.name = "RenPy Stream Smoke"
define config.screen_width = 640
define config.screen_height = 360
define config.save_directory = "renpy-stream-smoke"
define config.window = "hide"
default counter = 0

init python:
    import json
    import os

    gui.init(640, 360)
    config.quit_action = Quit(confirm=False)

    def smoke_screenshot():
        # Function actions return non-None results from call screen. Discard the
        # screenshot API's True result so capturing a frame does not end the game.
        renpy.screenshot(os.path.join(config.basedir, "frame.png"))

    def smoke_event(event):
        row = {
            "event": event,
            "counter": store.counter,
            "marker": persistent.smoke_marker,
            "savedir": config.savedir,
            "home": os.environ.get("HOME"),
            "version": renpy.version_only,
        }
        with open(os.path.join(config.basedir, "events.jsonl"), "ab") as output:
            output.write((json.dumps(row) + "\n").encode("utf-8"))

screen main_menu():
    tag menu
    add Solid("#14213d")
    text "RenPy Stream Smoke" xpos 30 ypos 25 color "#ffffff" size 32
    textbutton "Start (Enter)" xpos 30 ypos 100 action Start()
    textbutton "Load (L)" xpos 30 ypos 165 action FileLoad("1", page="smoke", confirm=False)
    key "K_RETURN" action Start()
    key "K_l" action FileLoad("1", page="smoke", confirm=False)
    on "show" action Function(smoke_event, "main_menu")

screen smoke_controls():
    add Solid("#14213d")
    text "RenPy Stream Smoke" xpos 30 ypos 25 color "#ffffff" size 32
    text "Counter: [counter]" xpos 30 ypos 85 color "#ffffff" size 26
    textbutton "Save (S)" xpos 30 ypos 140 action [SetField(persistent, "smoke_marker", "persisted"), Function(renpy.save_persistent), FileSave("1", page="smoke", confirm=False)]
    textbutton "Load (L)" xpos 30 ypos 205 action FileLoad("1", page="smoke", confirm=False)
    key "K_s" action [SetField(persistent, "smoke_marker", "persisted"), Function(renpy.save_persistent), FileSave("1", page="smoke", confirm=False)]
    key "K_l" action FileLoad("1", page="smoke", confirm=False)
    key "K_p" action Function(smoke_screenshot)
    on "show" action Function(smoke_event, "ready")

label start:
    # Make the progress part of the script checkpoint, not a transient screen action.
    $ counter = 42
    $ renpy.checkpoint()
    call screen smoke_controls
    return

label after_load:
    $ smoke_event("loaded")
    return
