{
  "name": "vn-stream-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit && node check-architecture.mjs",
    "format": "prettier --write src public tests tests-container *.ts *.mjs *.json",
    "format:check": "prettier --check src public tests tests-container *.ts *.mjs *.json",
    "test:container": "playwright test --config playwright.container.config.ts",
    "contract:generate": "node generate-contract.mjs",
    "contract:check": "node generate-contract.mjs --check"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.10.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "antd": "6.7.0",
    "lucide": "1.72.0",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
