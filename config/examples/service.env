# Set the single login account and password. Empty passwords refuse startup.
VN_STREAM_USERNAME=player
VN_STREAM_PASSWORD=
# Use your host UID/GID so existing NAS game files remain writable by their owner.
PUID=1000
PGID=1000
VN_STREAM_PORT=8443
# Optional direct HTTPS with containers/compose.https.yaml.
# VN_STREAM_HTTPS_BIND=192.168.1.10
# VN_STREAM_HTTPS_PORT=8443
# VN_STREAM_HTTPS_DIRECTORY=/srv/vn-stream/tls
# Select a published image or leave unset to build and use vn-stream:local.
# VN_STREAM_IMAGE=ghcr.io/mr-righter/vn-stream:v1.0.0
# Optional absolute host paths; defaults are relative to containers/compose.yaml.
# VN_STREAM_DATA=/srv/vn-stream/data
# VN_STREAM_GAMES=/srv/vn-stream/games
# Optional archive upload limit in bytes (default 20 GiB).
# VN_STREAM_UPLOAD_MAX_BYTES=21474836480
# New extracted projects are published here inside the container.
# VN_STREAM_LIBRARY_ROOT=/games

# All engine families use the same root; no additional engine mounts.
